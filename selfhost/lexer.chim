// ============================================================================
// Chimera lexer, written in Chimera.  Stage 1 of self-hosting.
//
// Mirrors src/lexer.rs. Verified by tests/selfhost.sh: for every .chim file in
// the repo its token dump must be byte-identical to `chimera tokens <file>`.
//
//   chimera build selfhost/lexer.chim -o build/lexer
//   build/lexer/target/release/lexer <file.chim>
// ============================================================================

data class Token(val kind: String, val start: Int, val end: Int, val nl: Bool, val text: String)

fun keywords(): Vec<String> = [
  "fun", "val", "var", "class", "trait", "data", "enum", "struct", "type", "abstract", "override", "open",
  "generic", "method", "before", "after", "around", "require", "ensure", "invariant", "old", "result",
  "if", "else", "while", "for", "in", "return", "break", "continue", "match", "true", "false", "nil",
  "this", "super", "is", "keyof", "sheet"
]

// longest first, exactly like the Rust lexer
fun operators(): Vec<String> = [
  "->>", "...", "?.", "?:", "!!", "->", "=>", "==", "!=", "<>", "<=", ">=", "&&", "||", "+=", "-=", "*=", "/=",
  "..", "+", "-", "*", "/", "%", "^", "&", "<", ">", "=", "!", "?", ".", ",", ":", ";", "(", ")", "[", "]",
  "{", "}", "|", "@"
]

fun isDigit(c: String): Bool = c >= "0" && c <= "9" && c != ""
fun isAlpha(c: String): Bool = (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_"
fun isIdent(c: String): Bool = isAlpha(c) || isDigit(c)

class Lexer(val src: Vec<String>) {
  var i: Int = 0
  var nl: Bool = true
  var toks: Vec<Token> = []
  val n: Int = src.count()

  fun at(k: Int): String = src[k] ?: ""
  fun cur(): String = at(i)
  fun peek(): String = at(i + 1)

  fun slice(a: Int, b: Int): String {
    var out = ""
    for k in a..b { out = out & src[k] }
    out
  }

  fun push(kind: String, start: Int) {
    toks = toks.push(Token(kind, start, i, nl, slice(start, i)))
    nl = false
  }

  fun matchesAt(op: String): Bool {
    val cs = op.chars()
    var k = 0
    while k < cs.count() {
      if at(i + k) != cs[k] { return false }
      k += 1
    }
    true
  }

  fun fail(msg: String): Result<Vec<Token>, String> = Err("$msg at offset $i")

  fun run(): Result<Vec<Token>, String> {
    val kws = keywords()
    val ops = operators()
    while i < n {
      val c = cur()
      if c == "\n" { nl = true; i += 1; continue }
      if c == " " || c == "\t" || c == "\r" { i += 1; continue }
      if c == "/" && peek() == "/" {
        while i < n && cur() != "\n" { i += 1 }
        continue
      }
      if c == "/" && peek() == "*" {
        i += 2
        while i + 1 < n && !(cur() == "*" && peek() == "/") { if cur() == "\n" { nl = true }; i += 1 }
        i += 2
        continue
      }
      val start = i
      if isDigit(c) {
        while isDigit(cur()) || cur() == "_" { i += 1 }
        var kind = "Int"
        if cur() == "." && isDigit(peek()) {
          kind = "Decimal"
          i += 1
          while isDigit(cur()) || cur() == "_" { i += 1 }
        }
        if (cur() == "e" || cur() == "E") && (isDigit(peek()) || peek() == "-" || peek() == "+") {
          kind = "Float"
          i += 2
          while isDigit(cur()) { i += 1 }
        }
        if cur() == "f" && !isIdent(peek()) { kind = "Float"; i += 1 }
        push(kind, start)
        continue
      }
      if isAlpha(c) {
        var w = ""
        while i < n && isIdent(cur()) { w = w & cur(); i += 1 }
        push(if kws.contains(w) { "Kw" } else { "Ident" }, start)
        continue
      }
      if c == "\"" {
        i += 1
        while true {
          if i >= n || cur() == "\n" { return fail("unterminated string literal") }
          val ch = cur()
          if ch == "\"" { i += 1; break }
          if ch == "\\" {
            if !["n", "t", "r", "\"", "\\", "$", "0"].contains(peek()) { return fail("unknown escape") }
            i += 2
            continue
          }
          if ch == "$" && peek() == "{" {
            i += 2
            var depth = 1
            while i < n {
              val d = cur()
              if d == "{" { depth += 1 }
              else if d == "}" { depth -= 1; if depth == 0 { break } }
              else if d == "\"" {
                i += 1
                while i < n && cur() != "\"" { if cur() == "\\" { i += 1 }; i += 1 }
              }
              i += 1
            }
            i += 1
            continue
          }
          i += 1
        }
        push("Str", start)
        continue
      }
      val op = ops.find(|o| matchesAt(o))
      if op == nil { return fail("unexpected character '$c'") }
      i += op.length
      push("Op", start)
    }
    toks = toks.push(Token("Eof", i, i, true, ""))
    Ok(toks)
  }
}

fun escape(s: String): String = s.replace("\\", "\\\\").replace("\n", "\\n").replace("\t", "\\t")

fun main() {
  val argv = args()
  if argv.count() < 1 { eprintln("usage: lexer <file.chim>"); exit(2) }
  val path = argv[0] ?: ""
  val src = match readFile(path) {
    Ok(text) => text
    Err(e) => { eprintln("error: cannot read $path: $e"); exit(1); "" }
  }
  match Lexer(src.chars()).run() {
    Ok(toks) => {
      var out = ""
      for t in toks { out = out & "${t.kind}\t${t.start}\t${t.end}\t${t.nl}\t${escape(t.text)}\n" }
      print(out)
    }
    Err(msg) => { eprintln("error: $msg"); exit(1) }
  }
}
