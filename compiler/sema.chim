// Semantic analysis (self-hosted). A port of src/sema.rs: class linearization (C3),
// override/abstract/diamond rules, name resolution, null safety with smart casts, record and
// utility types, units of measure, ordinals, contracts and match exhaustiveness.
//
// The checker is gradual: a type it cannot infer is `Any` and is not reported.

fun builtins(): Vec<String> = [
  "println", "print", "str", "atom", "range", "Ok", "Err", "panic", "assert",
  "SUM", "AVERAGE", "MIN", "MAX", "COUNT", "COUNTA", "PRODUCT", "MEDIAN", "ROUND", "ROUNDUP", "ROUNDDOWN", "ABS",
  "SQRT", "POWER", "MOD", "INT", "LEN", "UPPER", "LOWER", "TRIM", "LEFT", "RIGHT", "MID", "CONCATENATE", "TEXTJOIN",
  "SPLIT", "SUBSTITUTE", "SUMIF", "COUNTIF", "AVERAGEIF", "FILTER", "SORT", "UNIQUE", "SEQUENCE", "VLOOKUP", "INDEX",
  "MATCH", "ISBLANK", "ISNUMBER", "ISTEXT", "ISERROR", "MAP", "REDUCE", "TRUE", "FALSE", "UNIT", "CONVERT",
  "readFile", "writeFile", "args", "exit", "eprintln", "exec", "mkdirs", "embedFile",
  "__check", "__variant"
]
fun isBuiltin(n: String): Bool = builtins().contains(n)

data class FieldInfo(val name: String, val mutable: Bool, val ty: Ty, val owner: String)
// params: Vec of [name, type, hasDefault]
data class MethodSig(val owner: String, val params: Vec<Any>, val ret: Ty, val isAbstract: Bool)
data class ClassInfo(val name: String, val isTrait: Bool, val isData: Bool, val isAbstract: Bool, val mro: Vec<String>,
                     val fields: Vec<FieldInfo>, val ownMethods: Vec<String>, val methods: Map<String, MethodSig>,
                     val hasInvariants: Bool)

class Info {
  var classes: Map<String, ClassInfo> = {}
  var classOrder: Vec<String> = []
  var enums: Map<String, Vec<Any>> = {}        // enum -> [[variant, [field names]]]
  var variantOf: Map<String, String> = {}
  var funs: Map<String, Vec<Any>> = {}         // fun -> [params [[name, type, hasDefault]], return type]
  var generics: Map<String, Int> = {}
  var aliases: Map<String, Vec<Any>> = {}      // alias -> [type params, type node]

  fun cls(n: Any): Any = classes[n]
  fun variantFields(v: String): Vec<String>? {
    val en = variantOf[v] ?: return nil
    for x in enums[en] ?: [] { if x[0] == v { return x[1] } }
    nil
  }
  fun classHasField(c: String, n: String): Bool = (classes[c]?.fields ?: []).any(|f| f.name == n)
  fun classHasMethod(c: String, n: String): Bool = (classes[c]?.methods ?: {}).containsKey(n)
}

class Checker(val decls: Vec<Decl>) {
  val info: Info = Info()
  var diags: Vec<Diag> = []
  var ctorParams: Map<String, Any> = {}        // class -> [[name, hasDefault]]
  var ctorTypes: Map<String, Any> = {}         // "Class.param" -> type
  // body-check context
  var scopes: Vec<Any> = []                    // each: name -> [type, mutable, lambdaDepth]
  var curClass: Any = nil
  var inGeneric: Bool = false
  var inEnsure: Bool = false
  var retTy: Any = nil
  var lambdaDepth: Int = 0
  var loopDepth: Int = 0

  fun err(msg: String, span: Span) { diags = diags.push(Diag(msg, span)) }

  // ------------------------------------------------------------------ collection
  fun collect() {
    info.enums = info.enums.assoc("Result", [["Ok", ["value"]], ["Err", ["error"]]])
    info.variantOf = info.variantOf.assoc("Ok", "Result").assoc("Err", "Result")
    var seen: Map<String, Bool> = {}
    for d in decls {
      val defs: Vec<Any> = match d {
        DEnum(e) => [[e.name, e.span]] + e.variants.map(|v| [v.name, v.span])
        DTypeAlias(t) => [[t.name, t.span]]
        DClass(c) => [[c.name, c.span]]
        DFun(f) => [[f.name, f.span]]
        DGeneric(g) => [[g.name, g.span]]
        DMethod(_) => []
      }
      for x in defs {
        val n = x[0]
        if seen.containsKey(n) || (isBuiltin(n) && n != "Ok" && n != "Err") { err("'$n' is already defined", x[1]) }
        seen = seen.assoc(n, true)
      }
      match d {
        DEnum(e) => {
          info.enums = info.enums.assoc(e.name, e.variants.map(|v| [v.name, v.fields.map(|f| f.name)]))
          for v in e.variants { info.variantOf = info.variantOf.assoc(v.name, e.name) }
        }
        DTypeAlias(t) => { info.aliases = info.aliases.assoc(t.name, [t.typeParams, t.ty]) }
        DGeneric(g) => { info.generics = info.generics.assoc(g.name, g.params.count()) }
        _ => {}
      }
    }
    // functions
    for d in decls {
      match d {
        DFun(f) => {
          contractRules(f)
          info.funs = info.funs.assoc(f.name, funSig(f))
        }
        _ => {}
      }
    }
    // validate every type alias (utility types report bad keys etc.)
    for d in decls {
      match d {
        DTypeAlias(t) => {
          var subst: Map<String, Any> = {}
          for tp in t.typeParams { subst = subst.assoc(tp, YAny) }
          resolveIn(t.ty, subst)
        }
        _ => {}
      }
    }
    // constructor signatures
    for d in decls {
      match d {
        DClass(c) => {
          ctorParams = ctorParams.assoc(c.name, c.params.map(|p| [p.name, p.dflt != nil]))
          for p in c.params { if p.ty != nil { ctorTypes = ctorTypes.assoc("${c.name}.${p.name}", resolve(p.ty)) } }
        }
        _ => {}
      }
    }
    // classes in dependency order
    var byName: Map<String, ClassDecl> = {}
    var names: Vec<String> = []
    for d in decls { match d { DClass(c) => { byName = byName.assoc(c.name, c); names = names.push(c.name) }, _ => {} } }
    val v = ClassVisitor(byName, this)
    for n in names { v.visit(n) }
    for n in v.order {
      buildClass(byName[n]!!)
      if info.classes.containsKey(n) { info.classOrder = info.classOrder.push(n) }
    }
    // generic methods
    for d in decls {
      match d {
        DMethod(m) => {
          val k = info.generics[m.name]
          if k == nil { err("method for unknown generic function '${m.name}' (declare it with `generic ${m.name}(...)`)", m.span) }
          else if k != m.params.count() { err("generic '${m.name}' takes $k parameters but this method has ${m.params.count()}", m.span) }
          for p in m.params {
            match p.ty {
              TName(tn, _, tsp) => { if !isSpecializer(tn) { err("unknown specializer type '$tn'", tsp) } }
              _ => {}
            }
          }
        }
        _ => {}
      }
    }
  }

  /// Eiffel/Liskov: an override may only weaken preconditions and strengthen postconditions.
  fun contractRules(f: FunDecl) {
    if f.isOverride {
      if !f.requires.isEmpty() && !f.requireElse { err("'${f.name}' overrides an inherited method, so it may only weaken the precondition: write `require else`", f.span) }
      if !f.ensures.isEmpty() && !f.ensureThen { err("'${f.name}' overrides an inherited method, so it may only strengthen the postcondition: write `ensure then`", f.span) }
    } else {
      if f.requireElse { err("`require else` is only allowed when overriding, and '${f.name}' overrides nothing", f.span) }
      if f.ensureThen { err("`ensure then` is only allowed when overriding, and '${f.name}' overrides nothing", f.span) }
    }
  }

  fun isSpecializer(n: String): Bool =
    info.classes.containsKey(n) || info.enums.containsKey(n) || info.variantOf.containsKey(n) ||
      ["Any", "Int", "Float", "Decimal", "Quantity", "String", "Bool", "Nil", "Vec", "Map", "Fn", "Sheet", "Atom", "Number"].contains(n)

  /// [params [[name, type, hasDefault]], return type]
  fun funSig(f: FunDecl): Vec<Any> {
    var ps: Vec<Any> = []
    for p in f.params { ps = ps.push([p.name, if p.ty != nil { resolve(p.ty) } else { YAny }, p.dflt != nil]) }
    var ret: Any = YAny
    if f.ret != nil { ret = resolve(f.ret) }
    else if f.body != nil {
      val body: Any = f.body
      val isBlock = match body.kind { EBlock(_) => true, _ => false }
      if isBlock { ret = YUnit }
    }
    [ps, ret]
  }

  fun buildClass(c: ClassDecl) {
    if c.supers.any(|s| !info.classes.containsKey(s.name)) { return }
    // C3 linearization
    var seqs: Vec<Vec<String>> = c.supers.map(|s| info.classes[s.name]!!.mro)
    seqs = seqs.push(c.supers.map(|s| s.name))
    var mro: Vec<String> = [c.name]
    while true {
      seqs = seqs.filter(|s| !s.isEmpty())
      if seqs.isEmpty() { break }
      var cand: Any = nil
      for s in seqs {
        val h = s[0]
        if cand == nil && !seqs.any(|t| t.drop(1).contains(h)) { cand = h }
      }
      if cand == nil { err("cannot compute a consistent method resolution order (C3) for '${c.name}'", c.span); return }
      val h = cand
      seqs = seqs.map(|s| if s[0] == h { s.drop(1) } else { s })
      mro = mro.push(h)
    }
    for s in c.supers {
      val p = info.cls(s.name)
      if c.isTrait && !p.isTrait { err("trait '${c.name}' can only extend traits, but '${s.name}' is a class", s.span) }
      if p.isTrait && s.args != nil { err("trait '${s.name}' has no constructor", s.span) }
    }
    // fields: inherited (furthest ancestor first), then own
    var fields: Vec<FieldInfo> = []
    for anc in mro.drop(1).reverse() {
      for f in info.cls(anc).fields {
        if f.owner == anc && !fields.any(|x| x.name == f.name) { fields = fields.push(f) }
      }
    }
    var ownDefs: Vec<Any> = []        // [name, mutable, type node, span]
    for p in c.params { if p.field != nil { ownDefs = ownDefs.push([p.name, p.field == "var", p.ty, p.span]) } }
    for f in c.fields { ownDefs = ownDefs.push([f.name, f.mutable, f.ty, f.span]) }
    for od in ownDefs {
      val ty = if od[2] != nil { resolve(od[2]) } else { YAny }
      val existing = fields.find(|f| f.name == od[0])
      if existing != nil { err("field '${od[0]}' is already defined in '${existing.owner}'", od[3]) }
      else { fields = fields.push(FieldInfo(od[0], od[1], ty, c.name)) }
    }
    // methods: resolve through the MRO, check override rules and diamond ambiguity
    var methods: Map<String, MethodSig> = {}
    var own: Vec<String> = []
    for m in c.methods {
      contractRules(m)
      val sig = funSig(m)
      val inherited = mro.drop(1).find(|a| info.cls(a).ownMethods.contains(m.name))
      if inherited != nil && !m.isOverride { err("'${m.name}' overrides a member of '$inherited' and needs the 'override' modifier", m.span) }
      if inherited == nil && m.isOverride { err("'${m.name}' overrides nothing", m.span) }
      if fields.any(|f| f.name == m.name) { err("'${m.name}' is both a field and a method", m.span) }
      if own.contains(m.name) { err("method '${m.name}' is defined twice", m.span) }
      own = own.push(m.name)
      methods = methods.assoc(m.name, MethodSig(c.name, sig[0], sig[1], m.body == nil))
    }
    var inheritedNames: Vec<String> = []
    for a in mro.drop(1) { inheritedNames = inheritedNames + info.cls(a).ownMethods }
    for n in inheritedNames.distinct().sort() {
      if methods.containsKey(n) { continue }
      val providers = mro.drop(1).filter(|a| {
        val ci = info.cls(a)
        ci.ownMethods.contains(n) && !ci.methods[n].isAbstract
      })
      val maximal = providers.filter(|p| !providers.any(|q| q != p && info.cls(q).mro.contains(p)))
      if maximal.count() > 1 {
        err("'${c.name}' inherits conflicting implementations of '$n' from ${maximal.map(|s| "'$s'").join(" and ")}; override it (call `super<${maximal[0]}>.$n()` to pick one)", c.span)
        continue
      }
      var sig: Any = nil
      if !maximal.isEmpty() { sig = info.cls(maximal[0]).methods[n] } else {
        val a = mro.drop(1).find(|x| info.cls(x).ownMethods.contains(n))
        sig = info.cls(a).methods[n]
      }
      methods = methods.assoc(n, sig)
    }
    if !c.isAbstract {
      val missing = methods.keys().filter(|n| methods[n]!!.isAbstract).sort()
      if !missing.isEmpty() { err("class '${c.name}' must implement abstract member(s): ${missing.join(", ")}", c.span) }
    }
    val hasInv = !c.invariants.isEmpty() || mro.drop(1).any(|a| info.cls(a).hasInvariants)
    info.classes = info.classes.assoc(c.name, ClassInfo(c.name, c.isTrait, c.isData, c.isAbstract, mro, fields, own, methods, hasInv))
  }

  // ------------------------------------------------------------------ type resolution (incl. TS utility types)
  fun resolve(t: Any): Any = resolveIn(t, {})

  fun recordFields(name: String, t: Any, span: Span): Any {
    val k = kind(t)
    if k == "Record" { return t.fields }
    if k != "Any" { err("'$name' needs a record type, got ${showTy(t)}", span) }
    nil
  }
  fun litKeys(t: Any): Vec<String> {
    val k = kind(t)
    if k == "Lit" { return [t.text] }
    if k == "Union" { return t.options.filter(|x| kind(x) == "Lit").map(|x| x.text) }
    []
  }
  fun needArgs(name: String, a: Vec<Any>, n: Int, span: Span): Bool {
    if a.count() != n { err("'$name' expects $n type argument(s)", span); return false }
    true
  }

  fun resolveIn(t: Any, subst: Any): Any = match t {
    TNullable(i) => nullable(resolveIn(i, subst))
    TStrLit(s) => YLit(s)
    TUnion(ts) => { var out: Vec<Any> = []; for x in ts { out = out.push(resolveIn(x, subst)) }; YUnion(out) }
    TFn(ps, r) => { var out: Vec<Any> = []; for x in ps { out = out.push(resolveIn(x, subst)) }; YFn(out, resolveIn(r, subst)) }
    TRecord(fs) => { var out: Vec<Any> = []; for f in fs { out = out.push(RField(f.name, resolveIn(f.ty, subst), f.optional, f.readonly)) }; YRecord(out) }
    TKeyOf(i) => {
      val r = resolveIn(i, subst)
      if kind(r) == "Record" { YUnion(r.fields.map(|f| YLit(f.name))) } else { YStr }
    }
    TName(name, targs, span) => resolveName(name, targs, span, subst)
    _ => YAny
  }

  fun resolveName(name: String, targs: Vec<Any>, span: Span, subst: Any): Any {
    if subst.containsKey(name) { return subst[name] }
    var a: Vec<Any> = []
    for x in targs { a = a.push(resolveIn(x, subst)) }
    if name == "Int" { return YInt }
    if name == "Float" { return YFloat }
    if name == "Decimal" { return YDecimal }
    if name == "Quantity" {
      return match targs[0] {
        TName(u, _, _) => YQty([[u, 1]])
        TStrLit(u) => YQty([[u, 1]])
        _ => YAny
      }
    }
    if name == "String" { return YStr }
    if name == "Bool" { return YBool }
    if name == "Any" { return YAny }
    if name == "Unit" { return YUnit }
    if name == "Nil" { return YNil }
    if name == "Sheet" { return YSheet }
    if name == "Atom" { return YAtom }
    if name == "Number" { return YUnion([YInt, YDecimal, YFloat]) }
    if name == "Vec" || name == "List" { return YVec(a[0] ?: YAny) }
    if name == "Map" { return YMap(a[0] ?: YAny, a[1] ?: YAny) }
    // ---- TypeScript utility types
    if name == "Partial" || name == "Required" || name == "Readonly" || name == "Mutable" {
      if !needArgs(name, a, 1, span) { return YAny }
      val fs = recordFields(name, a[0], span)
      if fs == nil { return YAny }
      return YRecord(fs.map(|f|
        if name == "Partial" { RField(f.name, f.ty, true, f.readonly) }
        else if name == "Required" { RField(f.name, nonNull(f.ty), false, f.readonly) }
        else if name == "Readonly" { RField(f.name, f.ty, f.optional, true) }
        else { RField(f.name, f.ty, f.optional, false) }))
    }
    if name == "Pick" || name == "Omit" {
      if !needArgs(name, a, 2, span) { return YAny }
      val ks = litKeys(a[1])
      val fs = recordFields(name, a[0], span)
      if fs == nil { return YAny }
      for k in ks { if !fs.any(|f| f.name == k) { err("key \"$k\" does not exist in ${showTy(a[0])}", span) } }
      return YRecord(fs.filter(|f| ks.contains(f.name) == (name == "Pick")))
    }
    if name == "Record" {
      if !needArgs(name, a, 2, span) { return YAny }
      val ks = litKeys(a[0])
      if ks.isEmpty() { return YMap(a[0], a[1]) }
      return YRecord(ks.map(|k| RField(k, a[1], false, false)))
    }
    if name == "NonNullable" {
      if !needArgs(name, a, 1, span) { return YAny }
      return nonNull(a[0])
    }
    if name == "Exclude" || name == "Extract" {
      if !needArgs(name, a, 2, span) { return YAny }
      val dropped = if kind(a[1]) == "Union" { a[1].options } else { [a[1]] }
      val src = if kind(a[0]) == "Union" { a[0].options } else { [a[0]] }
      val out = src.filter(|x| dropped.contains(x) == (name == "Extract"))
      return if out.count() == 1 { out[0] } else { YUnion(out) }
    }
    if name == "ReturnType" {
      if !needArgs(name, a, 1, span) { return YAny }
      return if kind(a[0]) == "Fn" { a[0].ret } else { YAny }
    }
    if name == "Result" { return YEnum("Result") }
    if info.classes.containsKey(name) { return YClass(name) }
    if info.enums.containsKey(name) { return YEnum(name) }
    val alias = info.aliases[name]
    if alias != nil {
      val tps = alias[0]
      if tps.count() != a.count() { err("type '$name' expects ${tps.count()} type argument(s)", span); return YAny }
      var s: Map<String, Any> = {}
      for k in 0..tps.count() { s = s.assoc(tps[k], a[k]) }
      return resolveIn(alias[1], s)
    }
    if name.length == 1 && name >= "A" && name <= "Z" { return YAny }     // generic type parameter
    YClass(name)                                                          // forward reference to a class
  }

  /// Is a value of type `src` usable where `dst` is expected? Returns nil when it is, else why not.
  /// Only definite mismatches are reported.
  fun assignable(src: Any, dst: Any): Any {
    val ks = kind(src)
    val kd = kind(dst)
    if ks == "Any" || kd == "Any" || kd == "Unit" { return nil }
    if ks == "Nil" {
      if kd == "Nullable" || kd == "Nil" { return nil }
      return "nil cannot be assigned to non-nullable type ${showTy(dst)} (use ${showTy(dst)}?)"
    }
    if ks == "Nullable" {
      if kd == "Nullable" { return assignable(src.inner, dst.inner) }
      val inner = assignable(src.inner, dst)
      if inner == nil { return "type ${showTy(src)} is nullable but ${showTy(dst)} is not; use ?:, !! or a nil check" }
      return inner
    }
    if kd == "Nullable" { return assignable(src, dst.inner) }
    if (ks == "Int" && kd == "Float") || (ks == "Int" && kd == "Decimal") || (ks == "Decimal" && kd == "Float") { return nil }
    if ks == "Float" && kd == "Decimal" { return "Float cannot be used where Decimal is expected (floats are inexact); use a decimal literal like 1.5 or .toDecimal()" }
    if ks == "Qty" && kd == "Qty" {
      return if unitCompatible(src.unit, dst.unit) { nil } else { "unit mismatch: expected ${unitShow(dst.unit)} but found ${unitShow(src.unit)}" }
    }
    if ks == "Qty" && isPlainNum(dst) { return "a quantity in ${unitShow(src.unit)} cannot be used as a plain number; use .amount" }
    if isPlainNum(src) && kd == "Qty" { return "a plain number cannot be used as a quantity in ${unitShow(dst.unit)}; write e.g. `5 ${unitShow(dst.unit)}`" }
    if ks == "Lit" && kd == "Str" { return nil }
    if ks == "Lit" && kd == "Lit" && src.text == dst.text { return nil }
    if ks == "Union" {
      for o in src.options { val e = assignable(o, dst); if e != nil { return e } }
      return nil
    }
    if kd == "Union" {
      return if dst.options.any(|o| assignable(src, o) == nil) { nil } else { "${showTy(src)} is not one of ${showTy(dst)}" }
    }
    if ks == "Class" && kd == "Class" {
      val ci = info.cls(src.name)
      return if src.name == dst.name || ci == nil || ci.mro.contains(dst.name) { nil } else { "${src.name} is not a subtype of ${dst.name}" }
    }
    if ks == "Enum" && kd == "Enum" { return if src.name == dst.name { nil } else { "${src.name} is not ${dst.name}" } }
    if ks == "Record" && kd == "Record" {
      for d in dst.fields {
        val s = src.fields.find(|x| x.name == d.name)
        if s == nil {
          if !d.optional { return "missing required field '${d.name}'" }
        } else {
          if s.optional && !d.optional { return "field '${d.name}' is optional in the source but required in ${showTy(dst)}" }
          val e = assignable(s.ty, d.ty)
          if e != nil { return "field '${d.name}': $e" }
        }
      }
      return nil
    }
    if (ks == "Map" && kd == "Record") || (ks == "Record" && kd == "Map") { return nil }
    if ks == "Vec" && kd == "Vec" { return assignable(src.elem, dst.elem) }
    if ks == "Map" && kd == "Map" { return assignable(src.value, dst.value) }
    if ks == "Fn" && kd == "Fn" { return nil }
    if src == dst { return nil }
    "expected ${showTy(dst)} but found ${showTy(src)}"
  }

  fun expect(src: Any, dst: Any, span: Span) {
    val e = assignable(src, dst)
    if e != nil { err("type mismatch: $e", span) }
  }

  // ------------------------------------------------------------------ scopes
  fun pushScope() { scopes = scopes.push({}) }
  fun popScope() { scopes = scopes.take(scopes.count() - 1) }
  fun bind(n: String, entry: Any) { scopes = scopes.assoc(scopes.count() - 1, scopes.last().assoc(n, entry)) }
  fun declare(n: String, ty: Any, mutable: Bool) { bind(n, [ty, mutable, lambdaDepth]) }
  fun lookup(n: String): Any {
    var k = scopes.count() - 1
    while k >= 0 {
      val l = scopes[k][n]
      if l != nil { return l }
      k -= 1
    }
    nil
  }
  fun newContext(cname: Any) {
    scopes = [{}]
    curClass = cname
    inGeneric = false
    inEnsure = false
    retTy = nil
    lambdaDepth = 0
    loopDepth = 0
  }
  fun fieldOfCurrent(n: String): Any {
    if curClass == nil { return nil }
    val ci = info.cls(curClass)
    if ci == nil { return nil }
    ci.fields.find(|f| f.name == n)
  }
  fun methodOfCurrent(n: String): Any {
    if curClass == nil { return nil }
    val ci = info.cls(curClass)
    if ci == nil { return nil }
    ci.methods[n]
  }

  // ------------------------------------------------------------------ bodies
  fun checkBodies() {
    for d in decls {
      match d {
        DFun(f) => { newContext(nil); checkFun(f) }
        DClass(c) => checkClass(c)
        DMethod(m) => {
          newContext(nil)
          inGeneric = true
          for p in m.params {
            val t = match p.ty {
              TName(tn, _, _) => if info.classes.containsKey(tn) { YClass(tn) } else { YAny }
              _ => YAny
            }
            declare(p.name, t, false)
          }
          expr(m.body, nil)
        }
        _ => {}
      }
    }
    if !decls.any(|d| match d { DFun(f) => f.name == "main", _ => false }) { err("program has no `fun main()`", Span(0, 0)) }
  }

  fun checkClass(c: ClassDecl) {
    newContext(c.name)
    for p in c.params {
      if p.dflt != nil { expr(p.dflt, nil) }
      declare(p.name, if p.ty != nil { resolve(p.ty) } else { YAny }, false)
    }
    for s in c.supers {
      val parent = info.cls(s.name)
      if parent == nil || parent.isTrait { continue }
      val ps = (ctorParams[s.name] ?: []).map(|p| [p[0], YAny, p[1]])
      checkArgs("constructor of '${s.name}'", ps, s.args ?: [], s.span)
    }
    for f in c.fields {
      val t = expr(f.init, nil)
      if f.ty != nil { expect(t, resolve(f.ty), f.init.span) }
    }
    for inv in c.invariants { expect(expr(inv.expr, nil), YBool, inv.expr.span) }
    for m in c.methods {
      newContext(c.name)
      checkFun(m)
    }
  }

  fun checkFun(f: FunDecl) {
    for p in f.params {
      if p.dflt != nil { expr(p.dflt, nil) }
      declare(p.name, if p.ty != nil { resolve(p.ty) } else { YAny }, true)
    }
    for r in f.requires { expect(expr(r.expr, nil), YBool, r.expr.span) }
    val ret = if f.ret != nil { resolve(f.ret) } else { nil }
    retTy = ret
    val body: Any = f.body
    if body != nil {
      val t = expr(body, ret)
      if ret != nil {
        val isBlock = match body.kind { EBlock(_) => true, _ => false }
        if !isBlock || kind(t) != "Unit" { expect(t, ret, body.span) }
      }
    }
    for o in f.olds { expr(o, nil) }
    inEnsure = true
    pushScope()
    if ret != nil { declare("result", ret, false) }
    for e in f.ensures { expect(expr(e.expr, nil), YBool, e.expr.span) }
    popScope()
    inEnsure = false
  }

  /// params: [[name, type, hasDefault]]
  fun checkArgs(what: String, params: Any, cargs: Vec<Arg>, span: Span) {
    var filled: Vec<Bool> = params.map(|_| false)
    var pos = 0
    var named = false
    for a in cargs {
      var idx = -1
      if a.name != nil {
        named = true
        var k = 0
        while k < params.count() && idx < 0 { if params[k][0] == a.name { idx = k }; k += 1 }
        if idx < 0 {
          err("$what has no parameter named '${a.name}'", a.value.span)
          expr(a.value, nil)
          continue
        }
      } else {
        if named { err("positional argument after named argument", a.value.span) }
        idx = pos
        pos += 1
      }
      if idx >= params.count() {
        err("too many arguments for $what (expects ${params.count()})", a.value.span)
        expr(a.value, nil)
        continue
      }
      if filled[idx] == true { err("parameter '${params[idx][0]}' given twice", a.value.span) }
      filled = filled.assoc(idx, true)
      val t = expr(a.value, params[idx][1])
      expect(t, params[idx][1], a.value.span)
    }
    for k in 0..params.count() {
      if filled[k] == false && params[k][2] == false { err("missing argument '${params[k][0]}' for $what", span) }
    }
  }

  fun endsInJump(b: Block): Bool = match b.stmts.last() {
    SReturn(_, _) => true
    SBreak(_) => true
    SContinue(_) => true
    SExpr(x) => diverges(x)
    _ => false
  }

  fun block(b: Block, expected: Any): Any {
    pushScope()
    var last: Any = YUnit
    val n = b.stmts.count()
    for i in 0..n {
      val s = b.stmts[i]
      last = YUnit
      match s {
        SLet(mutable, name, ty, init, sp) => {
          val declared = if ty != nil { resolve(ty) } else { nil }
          val t = expr(init, declared)
          if declared != nil { expect(t, declared, init.span) }
          if isBuiltin(name) || info.classes.containsKey(name) { err("'$name' shadows a global name", sp) }
          declare(name, declared ?: t, mutable)
        }
        SAssign(target, _, value, sp) => assign(target, value, sp)
        SExpr(e) => {
          last = expr(e, if i + 1 == n { expected } else { nil })
          // `if x == nil { return }` smart-casts x to non-null for the rest of the block
          match e.kind {
            EIf(c, th, el) => {
              if el == nil && endsInJump(th) {
                val nm = nilCheck(c)[1]
                if nm != nil {
                  val l = lookup(nm)
                  if l != nil { bind(nm, [nonNull(l[0]), l[1], l[2]]) }
                }
              }
            }
            _ => {}
          }
        }
        SReturn(v, sp) => {
          if lambdaDepth == 0 {
            val t = if v != nil { expr(v, retTy) } else { YUnit }
            if retTy != nil && !(kind(t) == "Unit" && v == nil) { expect(t, retTy, if v != nil { v.span } else { sp }) }
          } else if v != nil { expr(v, nil) }
        }
        SWhile(c, body) => {
          expect(expr(c, nil), YBool, c.span)
          loopDepth += 1
          block(body, nil)
          loopDepth -= 1
        }
        SFor(name, it, body) => {
          val t = expr(it, nil)
          pushScope()
          declare(name, if kind(t) == "Vec" { t.elem } else { YAny }, false)
          loopDepth += 1
          block(body, nil)
          loopDepth -= 1
          popScope()
        }
        SBreak(sp) => { if loopDepth == 0 { err("break/continue outside of a loop", sp) } }
        SContinue(sp) => { if loopDepth == 0 { err("break/continue outside of a loop", sp) } }
      }
    }
    popScope()
    last
  }

  /// Check a block with `name` (if any) narrowed to its non-null type.
  fun narrowedBlock(name: Any, b: Block, expected: Any): Any {
    if !pushNarrow(name) { return block(b, expected) }
    val t = block(b, expected)
    popScope()
    t
  }
  fun pushNarrow(name: Any): Bool {
    if name == nil { return false }
    val l = lookup(name)
    if l == nil { return false }
    pushScope()
    bind(name, [nonNull(l[0]), l[1], l[2]])
    true
  }

  fun assign(target: Expr, value: Expr, span: Span) {
    match target.kind {
      EIdent(n) => {
        val l = lookup(n)
        if l != nil {
          if l[1] == false { err("cannot reassign 'val $n' (declare it with 'var')", target.span) }
          if l[2] < lambdaDepth { err("cannot assign captured variable '$n' inside a lambda; use an atom: `val $n = atom(...)` and `$n.swap(...)`", target.span) }
          expect(expr(value, l[0]), l[0], value.span)
        } else {
          val f = fieldOfCurrent(n)
          if f != nil {
            if !f.mutable { err("cannot assign to 'val' field '$n' of '${f.owner}'", target.span) }
            expect(expr(value, f.ty), f.ty, value.span)
          } else { err("unresolved name '$n'", target.span) }
        }
      }
      EMember(obj, name, _) => {
        val ot = expr(obj, nil)
        val ko = kind(ot)
        match obj.kind {
          EIdent(base) => {
            val l = lookup(base)
            if l != nil && (ko == "Record" || ko == "Map") && l[1] == false {
              err("cannot update field '$name' of 'val $base': records are immutable values; declare it with 'var' to rebind", target.span)
            }
          }
          _ => {}
        }
        if ko == "Record" {
          val f = ot.fields.find(|x| x.name == name)
          if f == nil { err("property '$name' does not exist on type ${showTy(ot)}", target.span) }
          else if f.readonly { err("cannot assign to '$name' because it is a read-only property", target.span) }
          else { expect(expr(value, f.ty), f.ty, value.span); return }
        } else if ko == "Class" {
          val ci = info.cls(ot.name)
          if ci != nil {
            val f = ci.fields.find(|x| x.name == name)
            if f != nil { if !f.mutable { err("cannot assign to 'val' field '$name' of '${f.owner}'", target.span) } }
            else { err("class '${ot.name}' has no field '$name'", target.span) }
          }
        } else if ko == "Nullable" {
          err("cannot assign through nullable receiver of type ${showTy(ot)}", target.span)
        }
        expr(value, nil)
      }
      EIndex(obj, idx) => {
        match obj.kind {
          EIdent(base) => {
            val l = lookup(base)
            if l != nil && l[1] == false { err("cannot update 'val $base' (collections are persistent; declare it with 'var' to rebind)", target.span) }
          }
          _ => {}
        }
        expr(obj, nil)
        expr(idx, nil)
        expr(value, nil)
      }
      _ => err("invalid assignment target", span)
    }
  }

  fun argExprs(cargs: Vec<Arg>) { for a in cargs { expr(a.value, nil) } }

  fun expr(e: Any, expected: Any): Any = match e.kind {
    EInt(_) => YInt
    EFloat(_) => YFloat
    EDecimal(_) => YDecimal
    EQuantity(x, u) => {
      val t = expr(x, nil)
      if !isPlainNum(t) && kind(t) != "Any" { err("unit '$u' must follow a number", e.span) }
      YQty([[u, 1]])
    }
    EStr(segs) => {
      for s in segs { match s { SegExpr(x) => expr(x, nil), _ => {} } }
      var out: Any = YStr
      val ke = kind(expected)
      if segs.count() == 1 && (ke == "Lit" || ke == "Union") {
        match segs[0] { SegLit(l) => { out = YLit(l) }, _ => {} }
      }
      out
    }
    EBool(_) => YBool
    ENil => YNil
    EThis => if curClass != nil { YClass(curClass) } else { err("'this' outside of a class", e.span); YAny }
    EResult => {
      if !inEnsure { err("'result' is only available in ensure clauses", e.span) }
      val l = lookup("result")
      if l != nil { l[0] } else { YAny }
    }
    EOld(x, _) => {
      if !inEnsure { err("'old(...)' is only available in ensure clauses", e.span) }
      expr(x, nil)
    }
    EIdent(n) => ident(n, e.span)
    ECellRef(_) => YAny
    ECellRange(_, _) => YVec(YAny)
    EBinary(op, l, r) => binary(op, l, r)
    EUnary(op, x) => {
      val t = expr(x, nil)
      if op == "!" { expect(t, YBool, x.span); YBool } else { t }
    }
    EPercent(x) => { expr(x, nil); YDecimal }
    EThread(_, _, _) => YAny
    ECall(callee, cargs) => call(callee, cargs, e.span)
    EMember(obj, name, safe) => member(expr(obj, nil), name, safe, e.span, obj)
    ESuper(q, name, cargs) => {
      if curClass == nil { err("'super' outside of a class", e.span); return YAny }
      val ci = info.cls(curClass)
      if q != nil {
        if !ci.mro.contains(q) || q == curClass { err("'$q' is not a supertype of '$curClass'", e.span) }
        else if !info.classHasMethod(q, name) { err("'$q' has no method '$name'", e.span) }
      } else if !ci.mro.drop(1).any(|a| info.classHasMethod(a, name)) {
        err("no supertype of '$curClass' defines '$name'", e.span)
      }
      argExprs(cargs)
      YAny
    }
    EIndex(o, i) => {
      val ot = expr(o, nil)
      expr(i, nil)
      val ko = kind(ot)
      if ko == "Vec" { nullable(ot.elem) }
      else if ko == "Map" { nullable(ot.value) }
      else if ko == "Nullable" { err("cannot index nullable value of type ${showTy(ot)}; use ?. or a nil check", o.span); YAny }
      else { YAny }
    }
    ELambda(ps, body) => {
      pushScope()
      lambdaDepth += 1
      val pts = if kind(expected) == "Fn" { expected.params } else { [] }
      for i in 0..ps.count() {
        val p = ps[i]
        declare(p.name, if p.ty != nil { resolve(p.ty) } else { pts[i] ?: YAny }, false)
      }
      val savedLoop = loopDepth
      loopDepth = 0
      val rt = expr(body, nil)
      loopDepth = savedLoop
      lambdaDepth -= 1
      popScope()
      YFn(ps.map(|_| YAny), rt)
    }
    EIf(c, t, el) => {
      expect(expr(c, nil), YBool, c.span)
      // Kotlin smart casts: `x != nil` narrows x in the then-branch, `x == nil` in the else-branch
      val nc = nilCheck(c)
      val tt = narrowedBlock(nc[0], t, expected)
      if el == nil { return YUnit }
      joinTy(tt, narrowedBlock(nc[1], el, expected))
    }
    EMatch(s, arms) => matchExpr(s, arms, expected)
    EVec(items) => {
      var et: Any = nil
      val expElem = if kind(expected) == "Vec" { expected.elem } else { nil }
      for i in items {
        val t = expr(i, expElem)
        if expElem != nil { expect(t, expElem, i.span) }
        et = if et == nil { t } else { joinTy(et, t) }
      }
      YVec(et ?: YAny)
    }
    EMap(entries) => mapLit(entries, e.span, expected)
    ETry(x) => {
      val t = expr(x, nil)
      if kind(t) == "Nullable" { t.inner } else { YAny }
    }
    ENotNull(x) => nonNull(expr(x, nil))
    ERange(a, b) => {
      val ta = expr(a, nil)
      val tb = expr(b, nil)
      expect(ta, YInt, a.span)
      expect(tb, YInt, b.span)
      YVec(YInt)
    }
    EBlock(b) => block(b, expected)
    EIs(x, ty) => {
      expr(x, nil)
      match ty { TName(tn, _, tsp) => { if !isSpecializer(tn) { err("unknown type '$tn'", tsp) } }, _ => {} }
      YBool
    }
    ESheet(cells) => {
      var seen: Vec<String> = []
      for c in cells {
        if seen.contains(c.cell) { err("cell ${c.cell} is defined twice", c.span) }
        seen = seen.push(c.cell)
        pushScope()
        lambdaDepth += 1      // formulas are closures
        expr(c.value, nil)
        lambdaDepth -= 1
        popScope()
      }
      YSheet
    }
    _ => YAny
  }

  fun ident(n: String, span: Span): Any {
    val l = lookup(n)
    if l != nil { return l[0] }
    val f = fieldOfCurrent(n)
    if f != nil { return f.ty }
    val m = methodOfCurrent(n)
    if m != nil { return YFn(m.params.map(|p| p[1]), m.ret) }
    val fn = info.funs[n]
    if fn != nil { return YFn(fn[0].map(|p| p[1]), fn[1]) }
    val en = info.variantOf[n]
    if en != nil {
      if (info.variantFields(n) ?: []).isEmpty() { return YEnum(en) }
      return YFn([], YEnum(en))
    }
    if info.classes.containsKey(n) || info.generics.containsKey(n) || isBuiltin(n) { return YAny }
    if n == "callNext" { return YAny }
    err("unresolved name '$n'", span)
    YAny
  }

  fun isOrd(t: Any): Bool = kind(t) == "Qty" && t.unit.count() == 1 && t.unit[0][0] == "ord"

  fun binary(op: String, l: Expr, r: Expr): Any {
    val lt = expr(l, nil)
    if op == "?:" {
      val rt0 = expr(r, nil)
      if diverges(r) { return nonNull(lt) }       // `x ?: return y`
      return joinTy(nonNull(lt), rt0)
    }
    // smart casts flow into the right operand: `x != nil && x.f`, `x == nil || x.f`
    val narrow = if op == "&&" { nilCheck(l)[0] } else if op == "||" { nilCheck(l)[1] } else { nil }
    val narrowed = pushNarrow(narrow)
    val rt = expr(r, nil)
    if narrowed { popScope() }
    val kl = kind(lt)
    val kr = kind(rt)
    if op == "&&" || op == "||" { expect(lt, YBool, l.span); expect(rt, YBool, r.span); return YBool }
    if op == "==" || op == "!=" { return YBool }
    if op == "<" || op == "<=" || op == ">" || op == ">=" {
      if kl == "Qty" && kr == "Qty" {
        if !unitCompatible(lt.unit, rt.unit) { err("cannot compare ${unitShow(lt.unit)} with ${unitShow(rt.unit)}: incompatible units", r.span) }
      }
      else if kl == "Qty" && isPlainNum(rt) { err("cannot compare a quantity in ${unitShow(lt.unit)} with a plain number", spanTo(l.span, r.span)) }
      else if isPlainNum(lt) && kr == "Qty" { err("cannot compare a quantity in ${unitShow(rt.unit)} with a plain number", spanTo(l.span, r.span)) }
      return YBool
    }
    if op == "&" { return YStr }
    if op == "+" && (kl == "Str" || kr == "Str") { return YStr }
    if !["+", "-", "*", "/", "%", "^"].contains(op) { return YAny }
    val both = spanTo(l.span, r.span)
    if kl == "Qty" || kr == "Qty" {
      val lo = isOrd(lt)
      val ro = isOrd(rt)
      // ordinals form an affine space over cardinals: position ± count = position, position − position = count
      if lo || ro {
        if (op == "+" || op == "-") && lo && !ro && (kr == "Int" || kr == "Any") { return lt }
        if op == "+" && !lo && ro && (kl == "Int" || kl == "Any") { return rt }
        if op == "-" && lo && ro { return YInt }
        if op == "+" && lo && ro { err("cannot add two ordinals (positions); subtract them to get a count, or add a count to a position", both); return YAny }
        if op == "+" || op == "-" { err("ordinals only move by whole cardinal numbers (Int), not by ${if lo { showTy(rt) } else { showTy(lt) }}", both); return YAny }
        err("operator '$op' is not defined for ordinals (positions); use a cardinal number", both)
        return YAny
      }
      val verb = if op == "-" { "subtract" } else { "add" }
      if (op == "+" || op == "-" || op == "%") && kl == "Qty" && kr == "Qty" {
        if !unitCompatible(lt.unit, rt.unit) { err("cannot $verb ${unitShow(lt.unit)} and ${unitShow(rt.unit)}: incompatible units", r.span) }
        return lt
      }
      if (op == "+" || op == "-") && kl == "Qty" && isPlainNum(rt) { err("cannot $verb a plain number and a quantity in ${unitShow(lt.unit)}; give the number a unit", both); return YAny }
      if (op == "+" || op == "-") && kr == "Qty" && isPlainNum(lt) { err("cannot $verb a plain number and a quantity in ${unitShow(rt.unit)}; give the number a unit", both); return YAny }
      if op == "*" && kl == "Qty" && kr == "Qty" {
        val u = unitCombine(lt.unit, rt.unit, 1)
        return if u.isEmpty() { YDecimal } else { YQty(u) }
      }
      if op == "/" && kl == "Qty" && kr == "Qty" {
        if unitCompatible(lt.unit, rt.unit) && !unitSame(lt.unit, rt.unit) { return YDecimal }
        val u = unitCombine(lt.unit, rt.unit, -1)
        return if u.isEmpty() { YDecimal } else { YQty(u) }
      }
      if op == "*" && kl == "Qty" { return lt }
      if op == "*" && kr == "Qty" { return rt }
      if op == "/" && kl == "Qty" { return lt }
      if op == "/" && kr == "Qty" { return YQty(unitCombine([], rt.unit, -1)) }
      return YAny
    }
    for side in [[lt, l], [rt, r]] {
      val t = side[0]
      val k = kind(t)
      if k == "Nullable" { err("operator '$op' cannot be applied to nullable type ${showTy(t)}", side[1].span) }
      else if !(isPlainNum(t) || k == "Any" || k == "Union") && !(op == "+" && k == "Vec") { err("operator '$op' expects numbers but found ${showTy(t)}", side[1].span) }
    }
    if op == "^" { return YFloat }
    if kl == "Int" && kr == "Int" { return YInt }
    if kl == "Float" || kr == "Float" { return YFloat }
    if (kl == "Decimal" && (kr == "Int" || kr == "Decimal")) || (kl == "Int" && kr == "Decimal") { return YDecimal }
    YAny
  }

  fun member(ot: Any, name: String, safe: Bool, span: Span, obj: Expr): Any {
    if !safe && kind(ot) == "Nullable" {
      err("only safe (?.) or non-null asserted (!!.) access is allowed on a nullable receiver of type ${showTy(ot)}", obj.span)
    }
    val base = nonNull(ot)
    val kb = kind(base)
    if kb == "Record" {
      val f = base.fields.find(|x| x.name == name)
      if f != nil {
        val t = if f.optional { nullable(f.ty) } else { f.ty }
        return if safe { nullable(t) } else { t }
      }
      if !["get", "assoc", "dissoc", "keys", "values", "count", "containsKey", "merge", "update", "toString", "isEmpty"].contains(name) {
        err("property '$name' does not exist on type ${showTy(base)}", span)
      }
      return YAny
    }
    if kb == "Class" {
      val ci = info.cls(base.name)
      if ci != nil {
        val f = ci.fields.find(|x| x.name == name)
        if f != nil { return if safe { nullable(f.ty) } else { f.ty } }
        val m = ci.methods[name]
        if m != nil { return YFn(m.params.map(|p| p[1]), if safe { nullable(m.ret) } else { m.ret }) }
        if !["toString", "copy", "equals"].contains(name) { err("'${base.name}' has no field or method '$name'", span) }
      }
      return YAny
    }
    if kb == "Str" { return if name == "length" { YInt } else { YAny } }
    if kb == "Qty" { return if name == "unit" { YStr } else { YAny } }
    YAny
  }

  fun builtinType(n: String, ats: Vec<Any>): Any {
    if ["str", "UPPER", "LOWER", "TRIM", "LEFT", "RIGHT", "MID", "CONCATENATE", "TEXTJOIN", "SUBSTITUTE", "embedFile"].contains(n) { return YStr }
    if ["LEN", "COUNT", "COUNTA", "COUNTIF", "exec"].contains(n) { return YInt }
    if ["ISBLANK", "ISNUMBER", "ISTEXT", "ISERROR", "TRUE", "FALSE"].contains(n) { return YBool }
    if ["println", "print", "eprintln", "writeFile", "exit"].contains(n) { return YUnit }
    if n == "readFile" || n == "Ok" || n == "Err" { return YEnum("Result") }
    if n == "args" { return YVec(YStr) }
    if n == "atom" { return YAtom }
    if n == "range" || n == "SEQUENCE" { return YVec(YInt) }
    if n == "SUM" || n == "MIN" || n == "MAX" {
      val first = ats[0]
      if kind(first) == "Vec" && kind(first.elem) == "Qty" { return first.elem }
      if kind(first) == "Qty" { return first }
    }
    YAny
  }

  fun call(callee: Expr, cargs: Vec<Arg>, span: Span): Any {
    match callee.kind {
      EIdent(n) if lookup(n) == nil && fieldOfCurrent(n) == nil => {
        if n == "callNext" {
          if !inGeneric { err("callNext() is only available inside generic methods", callee.span) }
          argExprs(cargs)
          return YAny
        }
        val m = methodOfCurrent(n)
        if m != nil { checkArgs("method '$n'", m.params, cargs, span); return m.ret }
        val f = info.funs[n]
        if f != nil { checkArgs("function '$n'", f[0], cargs, span); return f[1] }
        val ci = info.cls(n)
        if ci != nil {
          if ci.isAbstract { err("cannot instantiate ${if ci.isTrait { "trait" } else { "abstract class" }} '$n'", callee.span) }
          val ps = (ctorParams[n] ?: []).map(|p| {
            val fld = ci.fields.find(|x| x.name == p[0])
            [p[0], if fld != nil { fld.ty } else { ctorTypes["$n.${p[0]}"] ?: YAny }, p[1]]
          })
          checkArgs("constructor of '$n'", ps, cargs, span)
          return YClass(n)
        }
        val en = info.variantOf[n]
        if en != nil {
          val fields = info.variantFields(n) ?: []
          if cargs.count() != fields.count() { err("variant '$n' takes ${fields.count()} value(s) but ${cargs.count()} were given", span) }
          argExprs(cargs)
          return YEnum(en)
        }
        val k = info.generics[n]
        if k != nil {
          if cargs.count() != k { err("generic '$n' takes $k argument(s) but ${cargs.count()} were given", span) }
          argExprs(cargs)
          return YAny
        }
        if isBuiltin(n) {
          var ats: Vec<Any> = []
          for a in cargs {
            if a.name != nil { err("builtin functions take positional arguments only", a.value.span) }
            ats = ats.push(expr(a.value, nil))
          }
          return builtinType(n, ats)
        }
        err("unresolved function '$n'", callee.span)
        argExprs(cargs)
        return YAny
      }
      EMember(obj, name, safe) => {
        val ot = expr(obj, nil)
        val base = nonNull(ot)
        if kind(base) == "Class" {
          val c = base.name
          val ci = info.cls(c)
          val m = if ci != nil { ci.methods[name] } else { nil }
          if m != nil {
            if kind(ot) == "Nullable" && !safe { err("only safe (?.) or non-null asserted (!!.) calls are allowed on a nullable receiver of type ${showTy(ot)}", obj.span) }
            checkArgs("method '$c.$name'", m.params, cargs, span)
            return if safe { nullable(m.ret) } else { m.ret }
          }
          if name == "copy" {
            if ci != nil {
              if !ci.isData { err("copy() is only available on data classes; '$c' is not a data class", callee.span) }
              for a in cargs {
                if a.name == nil { err("copy() takes named arguments, e.g. p.copy(x = 1)", a.value.span) }
                else if !ci.fields.any(|x| x.name == a.name) { err("'$c' has no field '${a.name}'", a.value.span) }
                expr(a.value, nil)
              }
            }
            return YClass(c)
          }
        }
        val mt = member(ot, name, safe, callee.span, obj)
        argExprs(cargs)
        return if kind(mt) == "Fn" { mt.ret } else { YAny }
      }
      _ => {}
    }
    val ft = expr(callee, nil)
    argExprs(cargs)
    if kind(ft) == "Fn" { ft.ret } else { YAny }
  }

  fun mapLit(entries: Vec<MapEntry>, span: Span, expected: Any): Any {
    var expRec: Any = nil
    if kind(expected) == "Record" { expRec = expected.fields }
    else if kind(expected) == "Nullable" && kind(expected.inner) == "Record" { expRec = expected.inner.fields }
    var fields: Map<String, Any> = {}
    var order: Vec<String> = []
    var isRecord = true
    for en in entries {
      match en {
        MSpread(x) => {
          val st = expr(x, nil)
          if kind(st) == "Record" {
            for f in st.fields {
              val prev = fields[f.name]
              val keepRequired = prev != nil && !prev.optional
              if !order.contains(f.name) { order = order.push(f.name) }
              fields = fields.assoc(f.name, RField(f.name, f.ty, f.optional && !keepRequired, f.readonly))
            }
          } else { isRecord = false }
        }
        MKv(k, v) => {
          var key: Any = nil
          match k.kind {
            EStr(segs) => { if segs.count() == 1 { match segs[0] { SegLit(l) => { key = l }, _ => {} } } }
            _ => {}
          }
          if key == nil { expr(k, nil); isRecord = false }
          var fexp: Any = nil
          if key != nil && expRec != nil {
            val ef = expRec.find(|x| x.name == key)
            if ef != nil { fexp = ef.ty }
          }
          val vt = expr(v, fexp)
          if key != nil {
            if expRec != nil {
              val ef = expRec.find(|x| x.name == key)
              if ef == nil { err("object literal may only specify known properties, and '$key' does not exist in type ${showTy(YRecord(expRec))}", k.span) }
              else { expect(vt, if ef.optional { nullable(ef.ty) } else { ef.ty }, v.span) }
            }
            if !order.contains(key) { order = order.push(key) }
            fields = fields.assoc(key, RField(key, vt, false, false))
          }
        }
      }
    }
    if !isRecord { return YMap(YAny, YAny) }
    if expRec != nil {
      for f in expRec {
        if !f.optional && !fields.containsKey(f.name) { err("property '${f.name}' is missing but required in type ${showTy(YRecord(expRec))}", span) }
      }
      return YRecord(expRec)
    }
    YRecord(order.map(|n| fields[n]))
  }

  fun matchExpr(s: Expr, arms: Vec<MatchArm>, expected: Any): Any {
    val st = expr(s, nil)
    var out: Any = nil
    var catchAll = false
    var covered: Vec<String> = []
    val en = Atomic()
    if kind(st) == "Enum" { en.value = st.name }
    for a in arms {
      pushScope()
      pattern(a.pat, en)
      if a.guard == nil {
        match a.pat {
          PWild => { catchAll = true }
          PBind(_) => { catchAll = true }
          PVariant(vn, pargs, _) => { if pargs.all(|p| match p { PWild => true, PBind(_) => true, _ => false }) { covered = covered.push(vn) } }
          _ => {}
        }
      }
      val g: Any = a.guard
      if g != nil { expect(expr(g, nil), YBool, g.span) }
      val t = expr(a.body, expected)
      popScope()
      out = if out == nil { t } else { joinTy(out, t) }
    }
    if !catchAll && en.value != nil {
      val e = en.value
      val missing = (info.enums[e] ?: []).map(|v| v[0]).filter(|v| !covered.contains(v))
      if !missing.isEmpty() { err("non-exhaustive match on $e: missing ${missing.join(", ")}", s.span) }
    }
    out ?: YUnit
  }

  fun pattern(p: Pattern, en: Atomic) {
    match p {
      PBind(n) => declare(n, YAny, false)
      PLit(e) => expr(e, nil)
      PVariant(n, pargs, sp) => {
        val e = info.variantOf[n]
        if e == nil { err("unknown enum variant '$n'", sp) } else {
          if en.value == nil { en.value = e } else if en.value != e { err("variant '$n' belongs to '$e', not '${en.value}'", sp) }
          val k = (info.variantFields(n) ?: []).count()
          if pargs.count() != k { err("pattern '$n' expects $k field(s) but has ${pargs.count()}", sp) }
        }
        val inner = Atomic()
        for a in pargs { pattern(a, inner) }
      }
      _ => {}
    }
  }
}

/// a mutable cell for state threaded through recursive helpers
class Atomic {
  var value: Any = nil
}

class ClassVisitor(val byName: Map<String, ClassDecl>, val checker: Checker) {
  var state: Map<String, Int> = {}
  var order: Vec<String> = []
  fun visit(n: String) {
    val st = state[n]
    if st == 2 { return }
    if st == 1 { checker.err("cyclic inheritance involving '$n'", byName[n]!!.span); return }
    state = state.assoc(n, 1)
    for s in byName[n]!!.supers {
      if byName.containsKey(s.name) { visit(s.name) } else { checker.err("unknown superclass or trait '${s.name}'", s.span) }
    }
    state = state.assoc(n, 2)
    order = order.push(n)
  }
}

fun checkProgram(decls: Vec<Decl>): Result<Info, Vec<Diag>> {
  val c = Checker(decls)
  c.collect()
  if c.diags.isEmpty() { c.checkBodies() }
  if c.diags.isEmpty() { Ok(c.info) } else { Err(c.diags) }
}
