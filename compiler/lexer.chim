// Chimera lexer (self-hosted). Mirrors src/lexer.rs. Offsets are character offsets.

data class StrPart(val isExpr: Bool, val text: String, val offset: Int)

// kind: Ident | Kw | Int | Float | Decimal | Str | Op | Eof
data class Tok(val kind: String, val value: String, val parts: Vec<StrPart>, val start: Int, val end: Int, val nl: Bool)

fun keywords(): Vec<String> = [
  "fun", "val", "var", "class", "trait", "data", "enum", "struct", "type", "abstract", "override", "open",
  "generic", "method", "before", "after", "around", "require", "ensure", "invariant", "old", "result",
  "if", "else", "while", "for", "in", "return", "break", "continue", "match", "true", "false", "nil",
  "this", "super", "is", "keyof", "sheet", "check"
]

fun operators(): Vec<String> = [
  "->>", "...", "?.", "?:", "!!", "->", "=>", "==", "!=", "<>", "<=", ">=", "&&", "||", "+=", "-=", "*=", "/=",
  "..", "+", "-", "*", "/", "%", "^", "&", "<", ">", "=", "!", "?", ".", ",", ":", ";", "(", ")", "[", "]",
  "{", "}", "|", "@"
]

fun isDigit(c: String): Bool = c >= "0" && c <= "9" && c != ""
fun isAlpha(c: String): Bool = (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_"
fun isIdentChar(c: String): Bool = isAlpha(c) || isDigit(c)

class Lexer(val src: Vec<String>, val base: Int) {
  var i: Int = 0
  var nl: Bool = true
  var toks: Vec<Tok> = []
  val n: Int = src.count()
  val kws: Vec<String> = keywords()
  val ops: Vec<String> = operators()

  fun at(k: Int): String = src[k] ?: ""
  fun cur(): String = at(i)
  fun peek(): String = at(i + 1)

  fun slice(a: Int, b: Int): String {
    var out = ""
    for k in a..b { out = out & at(k) }
    out
  }

  fun push(kind: String, value: String, parts: Vec<StrPart>, start: Int) {
    toks = toks.push(Tok(kind, value, parts, start + base, i + base, nl))
    nl = false
  }

  fun matchesAt(op: String): Bool {
    val cs = op.chars()
    var k = 0
    while k < cs.count() {
      if at(i + k) != cs[k] { return false }
      k += 1
    }
    true
  }

  fun fail(msg: String, a: Int, b: Int): Result<Vec<Tok>, Diag> = Err(Diag(msg, Span(a + base, b + base)))

  fun run(): Result<Vec<Tok>, Diag> {
    while i < n {
      val c = cur()
      if c == "\n" { nl = true; i += 1; continue }
      if c == " " || c == "\t" || c == "\r" { i += 1; continue }
      if c == "/" && peek() == "/" {
        while i < n && cur() != "\n" { i += 1 }
        continue
      }
      if c == "/" && peek() == "*" {
        i += 2
        while i + 1 < n && !(cur() == "*" && peek() == "/") { if cur() == "\n" { nl = true }; i += 1 }
        i += 2
        continue
      }
      val start = i
      if isDigit(c) {
        while isDigit(cur()) || cur() == "_" { i += 1 }
        var isFloat = false
        var isDecimal = false
        if cur() == "." && isDigit(peek()) {
          isDecimal = true
          i += 1
          while isDigit(cur()) || cur() == "_" { i += 1 }
        }
        if (cur() == "e" || cur() == "E") && (isDigit(peek()) || peek() == "-" || peek() == "+") {
          isFloat = true
          i += 2
          while isDigit(cur()) { i += 1 }
        }
        val text = slice(start, i).replace("_", "")
        if cur() == "f" && !isIdentChar(peek()) { isFloat = true; i += 1 }
        val kind = if isFloat { "Float" } else if isDecimal { "Decimal" } else { "Int" }
        push(kind, text, [], start)
        continue
      }
      if isAlpha(c) {
        var w = ""
        while i < n && isIdentChar(cur()) { w = w & cur(); i += 1 }
        push(if kws.contains(w) { "Kw" } else { "Ident" }, w, [], start)
        continue
      }
      if c == "\"" {
        i += 1
        var parts: Vec<StrPart> = []
        var lit = ""
        while true {
          if i >= n || cur() == "\n" { return fail("unterminated string literal", start, i) }
          val ch = cur()
          if ch == "\"" { i += 1; break }
          if ch == "\\" {
            val e = peek()
            val r = match e {
              "n" => "\n"
              "t" => "\t"
              "r" => "\r"
              "\"" => "\""
              "\\" => "\\"
              "$" => "$"
              "0" => "\0"
              _ => { return fail("unknown escape '\\$e'", i, i + 2) }
            }
            lit = lit & r
            i += 2
            continue
          }
          if ch == "$" && peek() == "{" {
            if lit != "" { parts = parts.push(StrPart(false, lit, 0)); lit = "" }
            i += 2
            val es = i
            var depth = 1
            while i < n {
              val d = cur()
              if d == "{" { depth += 1 }
              else if d == "}" { depth -= 1; if depth == 0 { break } }
              else if d == "\"" {
                i += 1
                while i < n && cur() != "\"" { if cur() == "\\" { i += 1 }; i += 1 }
              }
              i += 1
            }
            parts = parts.push(StrPart(true, slice(es, i), es + base))
            i += 1
            continue
          }
          if ch == "$" && isAlpha(peek()) {
            if lit != "" { parts = parts.push(StrPart(false, lit, 0)); lit = "" }
            i += 1
            val es = i
            while i < n && isIdentChar(cur()) { i += 1 }
            parts = parts.push(StrPart(true, slice(es, i), es + base))
            continue
          }
          lit = lit & ch
          i += 1
        }
        if lit != "" || parts.isEmpty() { parts = parts.push(StrPart(false, lit, 0)) }
        push("Str", slice(start, i), parts, start)
        continue
      }
      val op = ops.find(|o| matchesAt(o))
      if op == nil { return fail("unexpected character '$c'", i, i + 1) }
      i += op.length
      push("Op", op, [], start)
    }
    toks = toks.push(Tok("Eof", "<eof>", [], i + base, i + base, true))
    Ok(toks)
  }
}

fun lex(src: Vec<String>, base: Int): Result<Vec<Tok>, Diag> = Lexer(src, base).run()

fun escapeTab(s: String): String = s.replace("\\", "\\\\").replace("\n", "\\n").replace("\t", "\\t")

/// `tokens` command: same dump format as stage 0 (`chimera tokens`)
fun dumpTokens(text: String): Result<String, Diag> {
  val cs = text.chars()
  val toks = lex(cs, 0)?
  var out: Vec<String> = []
  for t in toks {
    var raw = ""
    for k in t.start..t.end { raw = raw & (cs[k] ?: "") }
    out = out.push("${t.kind}\t${t.start}\t${t.end}\t${t.nl}\t${escapeTab(raw)}\n")
  }
  Ok(out.join(""))
}
