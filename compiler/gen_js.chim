// JavaScript backend (self-hosted). A faithful port of src/gen_js.rs: for the same program it emits
// byte-identical JavaScript. Chimera is expression-oriented (if/match/blocks yield values), so
// expressions are lowered into JS statements plus temporaries, preserving evaluation order.

fun jsReserved(): Vec<String> = [
  "arguments", "await", "break", "case", "catch", "class", "const", "continue", "debugger", "default", "delete", "do",
  "else", "enum", "eval", "export", "extends", "false", "finally", "for", "function", "if", "implements", "import", "in",
  "instanceof", "interface", "let", "new", "null", "package", "private", "protected", "public", "return", "static",
  "super", "switch", "this", "throw", "true", "try", "typeof", "var", "void", "while", "with", "yield", "undefined", "NaN", "Infinity"
]

fun jsname(n: String): String = if jsReserved().contains(n) { "${n}\$" } else { n }

fun jsLit(s: String): String {
  var out: Vec<String> = ["\""]
  for c in s.chars() {
    val code = c.code()
    val esc = match c {
      "\"" => "\\\""
      "\\" => "\\\\"
      "\n" => "\\n"
      "\r" => "\\r"
      "\t" => "\\t"
      _ => if code == 8232 { "\\u2028" } else if code == 8233 { "\\u2029" }
           else if code < 32 { val h = hexDigits(code); "\\u" & "0".repeat(4 - h.length) & h }
           else { c }
    }
    out = out.push(esc)
  }
  out = out.push("\"")
  out.join("")
}

fun allDigits(s: String): Bool = s.chars().all(|c| isDigit(c))

/// Expressions that are safe to evaluate later or drop (no side effects, not reassignable).
fun isSimpleJs(s: String): Bool {
  val t = s.trim()
  if t == "null" || t == "true" || t == "false" { return true }
  if t.startsWith("\$t") && allDigits(t.substring(2)) { return true }
  if t.endsWith("n") && t.length > 1 {
    var digits = t.substring(0, t.length - 1)
    while digits.startsWith("-") { digits = digits.substring(1) }
    if allDigits(digits) { return true }
  }
  t.length >= 2 && t.startsWith("\"") && t.endsWith("\"") && !t.substring(1, t.length - 1).contains("\"")
}

fun indentJs(lines: Vec<String>, lvl: Int): String {
  val pad = "  ".repeat(lvl)
  var out: Vec<String> = []
  for l in lines {
    var parts = l.split("\n")
    if parts.last() == "" { parts = parts.take(parts.count() - 1) }
    for x in parts { out = out.push(pad & x & "\n") }
  }
  out.join("")
}

fun generateJs(decls: Vec<Decl>, info: Info, baseDir: String): String {
  val d = Decls(decls).index()
  val g = JGen(info, d, baseDir)
  var out: Vec<String> = ["// ---- generated by the Chimera compiler. Do not edit.\n"]
  for e in d.enums {
    for v in e.variants {
      val ps = v.fields.map(|f| jsname(f.name)).join(", ")
      val names = v.fields.map(|f| jsLit(f.name)).join(", ")
      out = out.push("function ${e.name}__${v.name}($ps) { return \$rt.variant(${jsLit(e.name)}, ${jsLit(v.name)}, [$names], [$ps]); }\n")
    }
  }
  for decl in decls {
    match decl {
      DFun(f) => { out = out.push(g.function(f, fname(f.name), false, f.name)) }
      _ => {}
    }
  }
  for cname in info.classOrder { out = out.push(g.genClass(d.classes[cname]!!)) }
  var mi = 0
  for m in d.methods {
    g.scopes = [{}]
    g.buf = []
    var head: Vec<String> = []
    for k in 0..m.params.count() {
      val jn = g.declare(m.params[k]!!.name)
      head = head.push("  let $jn = \$args.length > $k ? \$args[$k] : null;\n")
    }
    val v = g.expr(m.body)
    val body = g.buf
    g.buf = []
    out = out.push("function ${m.name}__m$mi(\$args, \$next) {\n${head.join("")}${indentJs(body, 1)}  return $v;\n}\n")
    val specs = m.params.map(|p| match p.ty { TName(tn, _, _) => jsLit(tn), _ => jsLit("Any") }).join(", ")
    val q = if m.qualifier == "before" { 1 } else if m.qualifier == "after" { 2 } else if m.qualifier == "around" { 3 } else { 0 }
    g.reg = g.reg.push("  \$rt.registerMethod(${jsLit(m.name)}, { qual: $q, specs: [$specs], f: ${m.name}__m$mi });\n")
    mi += 1
  }
  out = out.push("function \$register() {\n${g.reg.join("")}}\n\$rt.run(() => { \$register(); chimera_main(); });\n")
  out.join("")
}

class JGen(val info: Info, val d: Decls, val baseDir: String) {
  var buf: Vec<String> = []
  var scopes: Vec<Any> = []          // each: Chimera name -> JS name
  var curClass: Any = nil
  var n: Int = 0
  var reg: Vec<String> = []

  fun tmp(): String { n += 1; "\$t$n" }
  fun emit(s: String) { buf = buf.push(s) }
  fun lookup(x: String): Any {
    var k = scopes.count() - 1
    while k >= 0 {
      val js = scopes[k][x]
      if js != nil { return js }
      k -= 1
    }
    nil
  }
  fun isLocal(x: String): Bool = lookup(x) != nil
  fun bind(x: String, js: String) { scopes = scopes.assoc(scopes.count() - 1, scopes.last().assoc(x, js)) }
  fun declare(x: String): String {
    var js = jsname(x)
    if isLocal(x) { n += 1; js = "${x}\$$n" }
    bind(x, js)
    js
  }
  fun pushScope() { scopes = scopes.push({}) }
  fun popScope() { scopes = scopes.take(scopes.count() - 1) }
  fun isField(x: String): Bool = curClass != nil && info.classHasField(curClass, x)
  fun isMethod(x: String): Bool = curClass != nil && info.classHasMethod(curClass, x)

  // ------------------------------------------------------------ declarations
  fun function(f: FunDecl, name: String, method_: Bool, where_: String): String {
    scopes = [{}]
    buf = []
    var ps: Vec<String> = []
    if method_ { ps = ps.push("\$this") }
    for p in f.params { ps = ps.push(declare(p.name)) }
    for r in f.requires {
      val c = expr(r.expr)
      emit("if (!\$rt.truthy($c)) \$rt.fail(${jsLit(contractMsg("precondition", where_, r))});")
    }
    val bodySrc = f.body ?: Expr(ENil, f.span)
    if f.ensures.isEmpty() {
      val v = expr(bodySrc)
      emit("return $v;")
    } else {
      for i in 0..f.olds.count() { val v = expr(f.olds[i]); emit("const \$old$i = $v;") }
      val saved = buf
      buf = []
      val v = expr(bodySrc)
      val inner = buf
      buf = saved
      emit("const result = (() => {\n${indentJs(inner, 1)}  return $v;\n})();")
      bind("result", "result")
      for e in f.ensures {
        val c = expr(e.expr)
        emit("if (!\$rt.truthy($c)) \$rt.fail(${jsLit(contractMsg("postcondition", where_, e))});")
      }
      emit("return result;")
    }
    val body = buf
    buf = []
    "function $name(${ps.join(", ")}) {\n${indentJs(body, 1)}}\n"
  }

  fun genClass(c: ClassDecl): String {
    val ci = info.cls(c.name)
    curClass = c.name
    var out: Vec<String> = ["// ---- ${if c.isTrait { "trait" } else { "class" }} ${c.name} (MRO: ${ci.mro.join(" -> ")})\n"]
    var table: Vec<String> = []
    for m in c.methods {
      if m.body == nil { continue }
      val fnn = "${c.name}__${m.name}"
      out = out.push(function(m, fnn, true, "${c.name}.${m.name}"))
      var targs: Vec<String> = []
      for i in 0..m.params.count() {
        val p = m.params[i]!!
        var def = "null"
        if p.dflt != nil { scopes = [{}]; def = pure(p.dflt) }
        targs = targs.push("a.length > $i ? a[$i] : $def")
      }
      table = table.push("[${jsLit(m.name)}, (t, a) => $fnn(t${if targs.isEmpty() { "" } else { ", " }}${targs.join(", ")})]")
    }
    var inv = "null"
    if !c.invariants.isEmpty() {
      scopes = [{}]
      buf = []
      for i in c.invariants {
        val v = expr(i.expr)
        val msg = if i.tag != nil { "${i.tag}: ${i.text}" } else { i.text }
        emit("if (!\$rt.truthy($v)) return ${jsLit(msg)};")
      }
      val body = buf
      buf = []
      out = out.push("function ${c.name}__inv(\$this) {\n${indentJs(body, 1)}  return null;\n}\n")
      inv = "${c.name}__inv"
    }
    if !c.isTrait {
      scopes = [{}]
      buf = []
      var ps: Vec<String> = []
      for p in c.params { ps = ps.push(declare(p.name)) }
      emit("if (!\$rt.beginInit(\$this, ${jsLit(c.name)})) return;")
      for s in c.supers {
        val pc = d.classes[s.name]
        if pc == nil || pc.isTrait { continue }
        val vals = ordered(pc.params, s.args ?: [])
        emit("${s.name}__init(\$this${if vals.isEmpty() { "" } else { ", " }}${vals.join(", ")});")
      }
      for p in c.params { if p.field != nil { emit("\$rt.set(\$this, ${jsLit(p.name)}, ${lookup(p.name)});") } }
      for f in c.fields { val v = expr(f.init); emit("\$rt.set(\$this, ${jsLit(f.name)}, $v);") }
      val body = buf
      buf = []
      val sep = if ps.isEmpty() { "" } else { ", " }
      out = out.push("function ${c.name}__init(\$this$sep${ps.join(", ")}) {\n${indentJs(body, 1)}}\n")
      out = out.push("function ${c.name}__new(${ps.join(", ")}) {\n  const \$this = \$rt.newObj(${jsLit(c.name)});\n  ${c.name}__init(\$this$sep${ps.join(", ")});\n  return \$rt.finishNew(\$this);\n}\n")
    }
    val mro = ci.mro.map(|m| jsLit(m)).join(", ")
    val fields = ci.fields.map(|f| jsLit(f.name)).join(", ")
    reg = reg.push("  \$rt.registerClass({ name: ${jsLit(c.name)}, mro: [$mro], methods: [${table.join(", ")}], invariant: $inv, hasInvariants: ${ci.hasInvariants}, data: ${ci.isData}, fields: [$fields] });\n")
    curClass = nil
    out.join("")
  }

  /// generate an expression that must not need statements (used for default values)
  fun pure(e: Any): String {
    val saved = buf
    buf = []
    val v = expr(e)
    val pre = buf
    buf = saved
    if pre.isEmpty() { v } else { "(() => {\n${indentJs(pre, 1)}  return $v;\n})()" }
  }

  // ------------------------------------------------------------ statements
  /// The block's statements as lines; the block's value (if `target` is given) is assigned to `target`.
  fun blockInto(b: Block, target: Any): Vec<String> {
    pushScope()
    val saved = buf
    buf = []
    val cnt = b.stmts.count()
    var lastIsExpr = false
    for i in 0..cnt {
      val s = b.stmts[i]
      val isLast = i + 1 == cnt
      match s {
        SExpr(e) => {
          if isLast { lastIsExpr = true }
          if isLast && target != nil { val v = expr(e); emit("$target = $v;") } else { stmt(s) }
        }
        _ => stmt(s)
      }
    }
    if target != nil && !lastIsExpr { emit("$target = null;") }
    val stmts = buf
    buf = saved
    popScope()
    stmts
  }

  fun assignStmt(target: Expr, value: Expr) {
    match target.kind {
      EIdent(x) => {
        val v = expr(value)
        if isLocal(x) { emit("${lookup(x)} = $v;") } else { emit("\$rt.set(\$this, ${jsLit(x)}, $v);") }
      }
      EMember(obj, name, _) => {
        val base = match obj.kind { EIdent(b) => b, _ => nil }
        if base != nil && isLocal(base) {
          val v = expr(value)
          val js = lookup(base)
          emit("$js = \$rt.setIn($js, ${jsLit(name)}, $v);")
        } else {
          val r = seq([obj, value])
          emit("\$rt.set(${r[0]}, ${jsLit(name)}, ${r[1]});")
        }
      }
      EIndex(obj, idx) => {
        val base = match obj.kind { EIdent(b) => b, _ => nil }
        if base != nil && isLocal(base) {
          val r = seq([idx, value])
          val js = lookup(base)
          emit("$js = \$rt.assoc($js, ${r[0]}, ${r[1]});")
        } else if base != nil && isField(base) {
          val r = seq([idx, value])
          val f = jsLit(base)
          emit("\$rt.set(\$this, $f, \$rt.assoc(\$rt.get(\$this, $f), ${r[0]}, ${r[1]}));")
        } else {
          val r = seq([obj, idx])
          emit("\$rt.index(${r[0]}, ${r[1]});")
        }
      }
      _ => {}
    }
  }

  fun stmt(s: Any) {
    match s {
      SLet(_, name, _, init, _) => {
        val v = expr(init)
        val js = declare(name)
        emit("let $js = $v;")
      }
      SAssign(target, _, value, _) => assignStmt(target, value)
      SExpr(e) => { val v = expr(e); if !isSimpleJs(v) { emit("$v;") } }
      SReturn(v, _) => { val x = if v != nil { expr(v) } else { "null" }; emit("return $x;") }
      SBreak(_) => emit("break;")
      SContinue(_) => emit("continue;")
      SWhile(c, b) => {
        val saved = buf
        buf = []
        val cond = expr(c)
        val pre = buf
        buf = saved
        val body = blockInto(b, nil)
        if pre.isEmpty() { emit("while (\$rt.truthy($cond)) {\n${indentJs(body, 1)}}") }
        else { emit("while (true) {\n${indentJs(pre, 1)}  if (!\$rt.truthy($cond)) break;\n${indentJs(body, 1)}}") }
      }
      SFor(name, it, b) => {
        match it.kind {
          ERange(from, to) => {
            val r = seq([from, to])
            val iv = tmp()
            val ev = tmp()
            pushScope()
            val js = declare(name)
            val body = blockInto(b, nil)
            popScope()
            emit("for (let $iv = \$rt.asInt(${r[0]}), $ev = \$rt.asInt(${r[1]}); $iv < $ev; $iv++) {\n  const $js = $iv;\n${indentJs(body, 1)}}")
          }
          _ => {
            val src = expr(it)
            pushScope()
            val js = declare(name)
            val body = blockInto(b, nil)
            popScope()
            emit("for (const $js of \$rt.iter($src)) {\n${indentJs(body, 1)}}")
          }
        }
      }
      _ => {}
    }
  }

  // ------------------------------------------------------------ expressions
  /// Evaluate expressions left to right; if a later one needs statements, earlier results are spilled to temps.
  fun seq(es: Vec<Any>): Vec<String> {
    var res: Vec<String> = []
    for e in es {
      val saved = buf
      buf = []
      val v = expr(e)
      val pre = buf
      buf = saved
      if !pre.isEmpty() {
        var k = 0
        while k < res.count() {
          val r = res[k] ?: ""
          if !isSimpleJs(r) { val t = tmp(); emit("const $t = $r;"); res = res.assoc(k, t) }
          k += 1
        }
        buf = buf + pre
      }
      res = res.push(v)
    }
    res
  }
  fun argsList(cargs: Vec<Arg>): String = "[${seq(cargs.map(|a| a.value)).join(", ")}]"
  fun ordered(params: Vec<Param>, cargs: Vec<Arg>): Vec<String> {
    val ord = orderArgs(params, cargs)
    var es: Vec<Any> = []
    for i in 0..params.count() {
      val p = params[i]!!
      val given = ord[i]
      es = es.push(if given != nil { given } else if p.dflt != nil { p.dflt } else { Expr(ENil, p.span) })
    }
    seq(es)
  }

  fun lambda(params: Vec<Param>, body: Expr, head: String): String {
    pushScope()
    var ps: Vec<String> = []
    for p in params { ps = ps.push(declare(p.name)) }
    val saved = buf
    buf = []
    val v = expr(body)
    val pre = buf
    buf = saved
    popScope()
    val h = if head == "" { "(${ps.join(", ")})" } else { head }
    if pre.isEmpty() { return "($h => ($v))" }
    "($h => {\n${indentJs(pre, 1)}  return $v;\n})"
  }

  fun fnValue(x: String): Any {
    if d.funs.containsKey(x) { return fname(x) }
    if d.classes.containsKey(x) { return "${x}__new" }
    if info.generics.containsKey(x) { return "((...a) => \$rt.callGeneric(${jsLit(x)}, a))" }
    nil
  }

  fun variantCall(vname: String, cargs: Vec<Arg>): String {
    if vname == "Ok" || vname == "Err" { return "\$rt.${vname.lower()}(...${argsList(cargs)})" }
    val en = info.variantOf[vname]
    val ed = d.enums.find(|e| e.name == en)
    val vd = ed.variants.find(|v| v.name == vname)
    "${en}__$vname(${ordered(vd.fields, cargs).join(", ")})"
  }

  fun isEnumVariantRef(obj: Expr, member: String): Bool = match obj.kind {
    EIdent(en) => !isLocal(en) && info.enums.containsKey(en) && info.variantOf[member] == en
    _ => false
  }

  fun call(callee: Expr, cargs: Vec<Arg>): String {
    match callee.kind {
      EIdent(x) if !isLocal(x) && !isField(x) => {
        if x == "embedFile" && cargs.count() == 1 {
          match cargs[0]!!.value.kind {
            EStr(segs) => {
              if segs.count() == 1 {
                match segs[0] {
                  SegLit(path) => {
                    val text = match readFile(baseDir & "/" & path) {
                      Ok(t) => t
                      Err(e) => { eprintln("error: embedFile: cannot read $path: $e"); exit(1); "" }
                    }
                    return jsLit(text)
                  }
                  _ => {}
                }
              }
            }
            _ => {}
          }
        }
        if x == "callNext" { return if cargs.isEmpty() { "\$next(\$args)" } else { "\$next(${argsList(cargs)})" } }
        if isMethod(x) { return "\$rt.callSelf(\$this, ${jsLit(x)}, ${argsList(cargs)})" }
        val f = d.funs[x]
        if f != nil { return "${fname(x)}(${ordered(f.params, cargs).join(", ")})" }
        val c = d.classes[x]
        if c != nil { return "${x}__new(${ordered(c.params, cargs).join(", ")})" }
        if info.variantOf.containsKey(x) { return variantCall(x, cargs) }
        if info.generics.containsKey(x) { return "\$rt.callGeneric(${jsLit(x)}, ${argsList(cargs)})" }
        if isBuiltin(x) {
          val a = seq(cargs.map(|ar| ar.value))
          val at0 = a[0] ?: "null"
          val at1 = a[1] ?: "null"
          return match x {
            "println" => "\$rt.println(${if a.isEmpty() { "\"\"" } else { at0 }})"
            "print" => "\$rt.print($at0)"
            "str" => "\$rt.toStr($at0)"
            "atom" => "\$rt.atom($at0)"
            "range" => "\$rt.range($at0, $at1)"
            "panic" => "\$rt.fail(\$rt.toStr($at0))"
            "assert" => "\$rt.assert($at0, ${if a.count() > 1 { at1 } else { "\"\"" }})"
            _ => "\$rt.sheets(${jsLit(x)}, [${a.join(", ")}])"
          }
        }
        val fe = expr(callee)
        return "\$rt.apply($fe, ${argsList(cargs)})"
      }
      EMember(obj, mname, safe) => {
        if isEnumVariantRef(obj, mname) { return variantCall(mname, cargs) }
        val r = seq([obj] + cargs.map(|a| a.value))
        if mname == "copy" && !cargs.isEmpty() && cargs.all(|a| a.name != nil) {
          var ch: Vec<String> = []
          for i in 0..cargs.count() { ch = ch.push("[${jsLit(cargs[i]!!.name ?: "")}, ${r[i + 1]}]") }
          return "\$rt.copy(${r[0]}, [${ch.join(", ")}])"
        }
        val av = "[${r.drop(1).join(", ")}]"
        val isThis = match obj.kind { EThis => true, _ => false }
        if isThis { return "\$rt.callSelf(${r[0]}, ${jsLit(mname)}, $av)" }
        return "\$rt.${if safe { "callSafe" } else { "call" }}(${r[0]}, ${jsLit(mname)}, $av)"
      }
      _ => {}
    }
    val r = seq([callee] + cargs.map(|a| a.value))
    "\$rt.apply(${r[0]}, [${r.drop(1).join(", ")}])"
  }

  fun pattern(p: Pattern, acc: String, out: PatAcc) {
    match p {
      PBind(x) => { out.binds = out.binds.push([x, acc]) }
      PLit(e) => { val v = pure(e); out.conds = out.conds.push("\$rt.eq($acc, $v)") }
      PVariant(vn, pargs, _) => {
        out.conds = out.conds.push("\$rt.isVariant($acc, ${jsLit(vn)})")
        for k in 0..pargs.count() { pattern(pargs[k]!!, "\$rt.vfield($acc, $k)", out) }
      }
      _ => {}
    }
  }

  fun binFn(op: String): String = match op {
    "+" => "add"
    "-" => "sub"
    "*" => "mul"
    "/" => "div"
    "%" => "rem"
    "^" => "pow"
    "&" => "amp"
    "==" => "opEq"
    "!=" => "opNe"
    "<" => "lt"
    "<=" => "le"
    ">" => "gt"
    ">=" => "ge"
    _ => "?"
  }

  fun expr(e: Any): String = match e.kind {
    EInt(i) => "${i}n"
    EFloat(f) => { val s = floatLit(f); if s.startsWith("-") { "($s)" } else { s } }
    EDecimal(t) => "\$rt.dec(${jsLit(t)})"
    EQuantity(x, u) => { val v = expr(x); "\$rt.qty($v, ${jsLit(u)})" }
    EStr(segs) => {
      if segs.count() == 1 {
        match segs[0] {
          SegLit(l) => { return jsLit(l) }
          _ => {}
        }
      }
      val es = segs.map(|sg| match sg { SegLit(l) => Expr(EStr([SegLit(l)]), e.span), SegExpr(x) => x })
      "\$rt.concat([${seq(es).join(", ")}])"
    }
    EBool(b) => str(b)
    ENil => "null"
    EThis => "\$this"
    EResult => "result"
    EOld(_, slot) => "\$old$slot"
    EIdent(x) => identExpr(x)
    ECellRef(c) => "\$rt.cell(\$sheet, ${jsLit(c)})"
    ECellRange(a, b) => "\$rt.cellRange(\$sheet, ${jsLit(a)}, ${jsLit(b)})"
    EBinary(op, l, r) => binaryExpr(op, l, r)
    EUnary(op, x) => { val v = expr(x); "\$rt.${if op == "-" { "neg" } else { "not" }}($v)" }
    ECall(c, cargs) => call(c, cargs)
    EMember(obj, mname, safe) => {
      if isEnumVariantRef(obj, mname) { variantCall(mname, []) }
      else { val o = expr(obj); "\$rt.${if safe { "getSafe" } else { "get" }}($o, ${jsLit(mname)})" }
    }
    ESuper(q, mname, cargs) => {
      val a = argsList(cargs)
      if q != nil { "\$rt.callFrom(\$this, ${jsLit(q)}, ${jsLit(mname)}, $a)" }
      else { "\$rt.callSuper(\$this, ${jsLit(curClass ?: "")}, ${jsLit(mname)}, $a)" }
    }
    EIndex(o, i) => { val r = seq([o, i]); "\$rt.index(${r[0]}, ${r[1]})" }
    ELambda(ps, b) => lambda(ps, b, "")
    EIf(c, t, el) => {
      val cond = expr(c)
      val tv = tmp()
      val tb = blockInto(t, tv)
      val eb = if el != nil { blockInto(el, tv) } else { ["$tv = null;"] }
      emit("let $tv;")
      emit("if (\$rt.truthy($cond)) {\n${indentJs(tb, 1)}} else {\n${indentJs(eb, 1)}}")
      tv
    }
    EBlock(b) => blockExpr(b)
    EMatch(subject, arms) => matchExpr(subject, arms)
    EVec(items) => "[${seq(items).join(", ")}]"
    EMap(entries) => mapExpr(entries)
    ETry(x) => {
      val v = expr(x)
      val t = tmp()
      emit("const $t = \$rt.tryBranch($v);")
      emit("if ($t.err) return $t.v;")
      "$t.v"
    }
    ENotNull(x) => { val v = expr(x); "\$rt.notNull($v, \"value\")" }
    ERange(a, b) => { val r = seq([a, b]); "\$rt.range(${r[0]}, ${r[1]})" }
    EIs(x, ty) => {
      val tn = match ty { TName(nm, _, _) => nm, _ => "Any" }
      val v = expr(x)
      "\$rt.isInstance($v, ${jsLit(tn)})"
    }
    ESheet(cells) => {
      var parts: Vec<String> = []
      for c in cells {
        if isFormula(c.value) { val f = lambda([], c.value, "(\$sheet)"); parts = parts.push("[${jsLit(c.cell)}, \$rt.formula($f)]") }
        else { val v = expr(c.value); parts = parts.push("[${jsLit(c.cell)}, $v]") }
      }
      "\$rt.sheet([${parts.join(", ")}])"
    }
    _ => "/* desugared */"
  }

  fun identExpr(x: String): String {
    val js = lookup(x)
    if js != nil { return js }
    if isField(x) || isMethod(x) { return "\$rt.get(\$this, ${jsLit(x)})" }
    val fv = fnValue(x)
    if fv != nil { return fv }
    if info.variantOf.containsKey(x) {
      if x == "Ok" || x == "Err" { return "\$rt.${x.lower()}" }
      val en = info.variantOf[x]
      if (info.variantFields(x) ?: []).isEmpty() { return "${en}__$x()" }
      return "${en}__$x"
    }
    if isBuiltin(x) { return "((...a) => \$rt.sheets(${jsLit(x)}, a))" }
    jsname(x)
  }

  fun binaryExpr(op: String, l: Expr, r: Expr): String {
    if op == "&&" || op == "||" || op == "?:" {
      val a = expr(l)
      val saved = buf
      buf = []
      val b = expr(r)
      val pre = buf
      buf = saved
      if op == "?:" {
        if pre.isEmpty() { return "($a ?? $b)" }
        val t = tmp()
        emit("let $t = $a;")
        emit("if ($t === null) {\n${indentJs(pre, 1)}  $t = $b;\n}")
        return t
      }
      if pre.isEmpty() { return "(\$rt.truthy($a) $op \$rt.truthy($b))" }
      val t = tmp()
      emit("let $t = \$rt.truthy($a);")
      emit("if (${if op == "&&" { "" } else { "!" }}$t) {\n${indentJs(pre, 1)}  $t = \$rt.truthy($b);\n}")
      return t
    }
    val r2 = seq([l, r])
    "\$rt.${binFn(op)}(${r2[0]}, ${r2[1]})"
  }

  fun blockExpr(b: Block): String {
    if b.stmts.count() == 1 {
      match b.stmts[0] {
        SExpr(x) => { return expr(x) }
        _ => {}
      }
    }
    val tv = tmp()
    val body = blockInto(b, tv)
    emit("let $tv;")
    emit("{\n${indentJs(body, 1)}}")
    tv
  }

  fun matchExpr(subject: Expr, arms: Vec<MatchArm>): String {
    val sv = expr(subject)
    val tv = tmp()
    val lbl = tmp().replace("\$", "m")
    val mv = tmp()
    var lines: Vec<String> = ["const $mv = $sv;"]
    for a in arms {
      val pa = PatAcc()
      pattern(a.pat, mv, pa)
      pushScope()
      var blk: Vec<String> = []
      for b in pa.binds { val js = declare(b[0] ?: ""); blk = blk.push("const $js = ${b[1]};") }
      val saved = buf
      buf = []
      val g: Any = a.guard
      if g != nil {
        val gv = expr(g)
        val outer = buf
        buf = []
        val v = expr(a.body)
        emit("$tv = $v;")
        emit("break $lbl;")
        val inner = buf
        buf = outer
        emit("if (\$rt.truthy($gv)) {\n${indentJs(inner, 1)}}")
      } else {
        val v = expr(a.body)
        emit("$tv = $v;")
        emit("break $lbl;")
      }
      blk = blk + buf
      buf = saved
      popScope()
      if pa.conds.isEmpty() { lines = lines.push("{\n${indentJs(blk, 1)}}") }
      else { lines = lines.push("if (${pa.conds.join(" && ")}) {\n${indentJs(blk, 1)}}") }
    }
    lines = lines.push("\$rt.fail(`no match arm for \${\$rt.repr($mv)}`);")
    emit("let $tv;")
    emit("$lbl: {\n${indentJs(lines, 1)}}")
    tv
  }

  fun mapExpr(entries: Vec<MapEntry>): String {
    var es: Vec<Any> = []
    for en in entries {
      match en {
        MSpread(x) => { es = es.push(x) }
        MKv(k, v) => { es = es.push(k); es = es.push(v) }
      }
    }
    val r = seq(es)
    var i = 0
    if entries.all(|en| match en { MKv(_, _) => true, _ => false }) {
      var pairs: Vec<String> = []
      for en in entries { pairs = pairs.push("[${r[i]}, ${r[i + 1]}]"); i += 2 }
      return "\$rt.map([${pairs.join(", ")}])"
    }
    var acc = "\$rt.map([])"
    for en in entries {
      match en {
        MSpread(_) => { acc = "\$rt.merge($acc, ${r[i]})"; i += 1 }
        MKv(_, _) => { acc = "\$rt.assoc($acc, ${r[i]}, ${r[i + 1]})"; i += 2 }
      }
    }
    acc
  }
}
