// Rust backend (self-hosted). A faithful port of src/gen_rust.rs: for the same program it must
// emit byte-identical Rust (checked by tests/bootstrap.sh).

fun fname(n: String): String = if n == "main" { "chimera_main" } else { "f_$n" }

fun generateRust(decls: Vec<Decl>, info: Info, baseDir: String): String {
  val d = Decls(decls).index()
  val g = Gen(info, d, baseDir)
  var out: Vec<String> = ["// Generated by the Chimera compiler. Do not edit.\n#![allow(warnings, unused)]\nmod rt;\nuse rt::Value;\n\n"]
  for e in d.enums {
    for v in e.variants {
      val ps = v.fields.map(|f| "${rid(f.name)}: Value").join(", ")
      val names = v.fields.map(|f| lit(f.name)).join(", ")
      val vals = v.fields.map(|f| rid(f.name)).join(", ")
      out = out.push("fn ${e.name}__${v.name}($ps) -> Value { rt::variant(${lit(e.name)}, ${lit(v.name)}, &[$names], vec![$vals]) }\n")
    }
  }
  val sigs = analyzeNative(decls)
  val ng = NGen(sigs, decls).init()
  for decl in decls {
    match decl {
      DFun(f) => {
        if sigs.containsKey(f.name) { out = out.push(ng.function(f, fname(f.name))) }
        else { out = out.push(g.function(f, fname(f.name), false, f.name)) }
      }
      _ => {}
    }
  }
  for cname in info.classOrder { out = out.push(g.genClass(d.classes[cname]!!)) }
  var mi = 0
  for m in d.methods {
    g.inGeneric = true
    g.scopes = [[]]
    var body: Vec<String> = []
    for k in 0..m.params.count() {
      val p = m.params[k]!!
      body = body.push("    let mut ${rid(p.name)} = __args.get($k).cloned().unwrap_or(Value::Nil);\n")
      g.declare(p.name)
    }
    val b = g.expr(m.body)
    out = out.push("fn ${m.name}__m$mi(__args: Vec<Value>, __next: &dyn Fn(Vec<Value>) -> Value) -> Value {\n${body.join("")}    $b\n}\n")
    val specs = m.params.map(|p| match p.ty { TName(tn, _, _) => lit(tn), _ => lit("Any") }).join(", ")
    val q = if m.qualifier == "before" { 1 } else if m.qualifier == "after" { 2 } else if m.qualifier == "around" { 3 } else { 0 }
    g.reg = g.reg.push("    rt::register_method(${lit(m.name)}, rt::GMethod { qual: $q, specs: &[$specs], f: ${m.name}__m$mi });\n")
    g.inGeneric = false
    mi += 1
  }
  out = out.push("\nfn register() {\n${g.reg.join("")}}\n\nfn main() {\n    rt::run(|| { register(); chimera_main() });\n}\n")
  out.join("")
}

class Gen(val info: Info, val d: Decls, val baseDir: String) {
  var scopes: Vec<Vec<String>> = []
  var curClass: String? = nil
  var loops: Vec<String> = []
  var n: Int = 0
  var inGeneric: Bool = false
  var reg: Vec<String> = []

  fun fresh(p: String): String { n += 1; "$p$n" }
  fun declare(x: String) { scopes = scopes.assoc(scopes.count() - 1, scopes.last()!!.push(x)) }
  fun pushScope(names: Vec<String>) { scopes = scopes.push(names) }
  fun popScope() { scopes = scopes.take(scopes.count() - 1) }
  fun isLocal(x: String): Bool = scopes.any(|s| s.contains(x))
  fun isField(x: String): Bool = curClass != nil && info.classHasField(curClass!!, x)
  fun isMethod(x: String): Bool = curClass != nil && info.classHasMethod(curClass!!, x)

  fun rf(e: Expr): String = match e.kind {
    EIdent(x) if isLocal(x) => "&${rid(x)}"
    EThis => "&this"
    _ => {
      val s = expr(e)
      if s.startsWith("'") || s.startsWith("if ") || s.startsWith("match ") { "&($s)" } else { "&$s" }
    }
  }

  // ------------------------------------------------------------ declarations
  fun paramsList(ps: Vec<Param>): String = ps.map(|p| "mut ${rid(p.name)}: Value").join(", ")

  fun function(f: FunDecl, name: String, isMethod: Bool, where_: String): String {
    scopes = [[]]
    loops = []
    for p in f.params { declare(p.name) }
    var sig: Vec<String> = []
    if isMethod { sig = sig.push("this: Value") }
    val pl = paramsList(f.params)
    if pl != "" { sig = sig.push(pl) }
    var b: Vec<String> = []
    for r in f.requires {
      val c = rf(r.expr)
      b = b.push("    if !rt::truthy($c) {\n        rt::fail(${lit(contractMsg("precondition", where_, r))});\n    }\n")
    }
    val body = if f.body != nil { expr(f.body!!) } else { "Value::Nil" }
    if f.ensures.isEmpty() {
      b = b.push("    $body\n")
    } else {
      for k in 0..f.olds.count() { b = b.push("    let __old$k = ${expr(f.olds[k]!!)};\n") }
      b = b.push("    let result: Value = (|| -> Value { $body })();\n")
      declare("result")
      for e in f.ensures {
        val c = rf(e.expr)
        b = b.push("    if !rt::truthy($c) {\n        rt::fail(${lit(contractMsg("postcondition", where_, e))});\n    }\n")
      }
      b = b.push("    result\n")
    }
    "fn $name(${sig.join(", ")}) -> Value {\n${b.join("")}}\n\n"
  }

  fun genClass(c: ClassDecl): String {
    val ci = info.classes[c.name]!!
    curClass = c.name
    var out: Vec<String> = ["// ---- ${if c.isTrait { "trait" } else { "class" }} ${c.name} (MRO: ${ci.mro.join(" -> ")})\n"]
    var table: Vec<String> = []
    for m in c.methods {
      if m.body == nil { continue }
      val fnn = "${c.name}__${m.name}"
      out = out.push(function(m, fnn, true, "${c.name}.${m.name}"))
      var targs: Vec<String> = []
      for k in 0..m.params.count() {
        val p = m.params[k]!!
        var def = "Value::Nil"
        if p.dflt != nil { scopes = [[]]; def = expr(p.dflt!!) }
        targs = targs.push("a.get($k).cloned().unwrap_or_else(|| $def)")
      }
      val sep = if targs.isEmpty() { "" } else { ", " }
      table = table.push("(${lit(m.name)}, |t: Value, a: Vec<Value>| $fnn(t$sep${targs.join(", ")}))")
    }
    var inv = "None"
    if !c.invariants.isEmpty() {
      scopes = [[]]
      var b: Vec<String> = []
      for i in c.invariants {
        val cond = rf(i.expr)
        val msg = if i.tag != nil { "${i.tag}: ${i.text}" } else { i.text }
        b = b.push("    if !rt::truthy($cond) {\n        return Some(${lit(msg)});\n    }\n")
      }
      out = out.push("fn inv_${c.name}(this: &Value) -> Option<&'static str> {\n    let this = this.clone();\n${b.join("")}    None\n}\n\n")
      inv = "Some(inv_${c.name})"
    }
    if !c.isTrait {
      scopes = [[]]
      for p in c.params { declare(p.name) }
      var b: Vec<String> = ["    if !rt::begin_init(this, ${lit(c.name)}) { return; }\n    let this = this.clone();\n"]
      for s in c.supers {
        val pc = d.classes[s.name]
        if pc == nil || pc.isTrait { continue }
        val ord = orderArgs(pc.params, s.args ?: [])
        var vals: Vec<String> = []
        for k in 0..pc.params.count() {
          val given = ord[k]
          val p = pc.params[k]!!
          vals = vals.push(if given != nil { expr(given) } else if p.dflt != nil { expr(p.dflt!!) } else { "Value::Nil" })
        }
        b = b.push("    init_${s.name}(&this${if vals.isEmpty() { "" } else { ", " }}${vals.join(", ")});\n")
      }
      for p in c.params { if p.field != nil { b = b.push("    rt::set(&this, ${lit(p.name)}, ${rid(p.name)}.clone());\n") } }
      for f in c.fields { b = b.push("    rt::set(&this, ${lit(f.name)}, ${expr(f.init)});\n") }
      val ps = paramsList(c.params)
      out = out.push("fn init_${c.name}(this: &Value${if ps == "" { "" } else { ", " }}$ps) {\n${b.join("")}}\n")
      val names = c.params.map(|p| rid(p.name)).join(", ")
      val plain = c.params.map(|p| "${rid(p.name)}: Value").join(", ")
      out = out.push("fn new_${c.name}($plain) -> Value {\n    let this = rt::new_obj(${lit(c.name)});\n    init_${c.name}(&this${if names == "" { "" } else { ", " }}$names);\n    rt::finish_new(this)\n}\n\n")
    }
    val mro = ci.mro.map(|m| lit(m)).join(", ")
    val fields = ci.fields.map(|f| lit(f.name)).join(", ")
    reg = reg.push("    rt::register_class(rt::ClassInfo { name: ${lit(c.name)}, mro: &[$mro], methods: vec![${table.join(", ")}], invariant: $inv, has_invariants: ${ci.hasInvariants}, data: ${ci.isData}, fields: &[$fields] });\n")
    curClass = nil
    out.join("")
  }

  // ------------------------------------------------------------ statements
  fun block(b: Block): String {
    pushScope([])
    var parts: Vec<String> = []
    var hasValue = false
    val cnt = b.stmts.count()
    for k in 0..cnt {
      val s = b.stmts[k]!!
      val isLast = k + 1 == cnt
      val part = match s {
        SExpr(e) if isLast => { hasValue = true; expr(e) }
        _ => stmt(s)
      }
      parts = parts.push(part)
    }
    if !hasValue { parts = parts.push("Value::Nil") }
    popScope()
    "{ ${parts.join(" ")} }"
  }

  fun isIdentNamed(e: Expr, x: String): Bool = match e.kind { EIdent(o) => o == x, _ => false }
  fun isStrLit(e: Expr): Bool = match e.kind { EStr(_) => true, _ => false }

  fun assignStmt(target: Expr, value: Expr): String {
    val tname = match target.kind { EIdent(x) => x, _ => "" }
    if tname != "" {
      match value.kind {
        ECall(c, cargs) => match c.kind {
          EMember(obj, mname, false) => {
            if isIdentNamed(obj, tname) && isLocal(tname) && cargs.all(|a| a.name == nil) {
              if (mname == "push" || mname == "conj") && cargs.count() == 1 { val x = expr(cargs[0]!!.value); return "{ let __v = $x; rt::push_mut(&mut ${rid(tname)}, __v); }" }
              if mname == "assoc" && cargs.count() == 2 {
                val k = expr(cargs[0]!!.value)
                val x = expr(cargs[1]!!.value)
                return "{ let __k = $k; let __v = $x; rt::assoc_mut(&mut ${rid(tname)}, __k, __v); }"
              }
            }
            if isIdentNamed(obj, tname) && !isLocal(tname) && isField(tname) && (mname == "push" || mname == "conj") && cargs.count() == 1 {
              val x = expr(cargs[0]!!.value)
              return "rt::field_push_mut(&this, ${lit(tname)}, $x);"
            }
          }
          _ => {}
        }
        EBinary(op, l, r) => {
          if (op == "&" || (op == "+" && isStrLit(r))) && isIdentNamed(l, tname) && isLocal(tname) {
            val x = expr(r)
            return "{ let __v = $x; rt::str_append(&mut ${rid(tname)}, &__v); }"
          }
        }
        _ => {}
      }
    }
    val v = expr(value)
    match target.kind {
      EIdent(x) => if isLocal(x) { "${rid(x)} = $v;" } else { "rt::set(&this, ${lit(x)}, $v);" }
      EMember(obj, mname, _) => match obj.kind {
        EIdent(b) if isLocal(b) => "{ let __v = $v; ${rid(b)} = rt::set_in(&${rid(b)}, ${lit(mname)}, __v); }"
        _ => { val o = expr(obj); "rt::set(&$o, ${lit(mname)}, $v);" }
      }
      EIndex(obj, idx) => {
        val i = expr(idx)
        match obj.kind {
          EIdent(b) if isLocal(b) => "{ let __v = $v; let __i = $i; ${rid(b)} = rt::assoc(&${rid(b)}, __i, __v); }"
          EIdent(b) if isField(b) => "{ let __v = $v; let __i = $i; rt::set(&this, ${lit(b)}, rt::assoc(&rt::get(&this, ${lit(b)}), __i, __v)); }"
          _ => { val o = expr(obj); "rt::index(&$o, &$i);" }
        }
      }
      _ => ""
    }
  }

  fun stmt(s: Stmt): String = match s {
    SLet(_, x, _, init, _) => {
      val v = expr(init)
      declare(x)
      "let mut ${rid(x)}: Value = $v;"
    }
    SAssign(target, _, value, _) => assignStmt(target, value)
    SExpr(e) => "${expr(e)};"
    SReturn(v, _) => "return ${if v != nil { expr(v!!) } else { "Value::Nil" }};"
    SBreak(_) => "break ${loops.last() ?: ""};"
    SContinue(_) => "continue ${loops.last() ?: ""};"
    SWhile(c, b) => {
      val l = fresh("'l")
      val cond = rf(c)
      loops = loops.push(l)
      val body = block(b)
      loops = loops.take(loops.count() - 1)
      "$l: while rt::truthy($cond) { $body; }"
    }
    SFor(x, it, b) => {
      val l = fresh("'l")
      match it.kind {
        ERange(from, to) => {
          val f = expr(from)
          val t = expr(to)
          val iv = fresh("__i")
          val ev = fresh("__e")
          pushScope([x])
          loops = loops.push(l)
          val body = block(b)
          loops = loops.take(loops.count() - 1)
          popScope()
          "{ let mut $iv = rt::as_int(&($f)); let $ev = rt::as_int(&($t)); $l: while $iv < $ev { let mut ${rid(x)}: Value = Value::Int($iv); $iv += 1; $body; } }"
        }
        _ => {
          val src = rf(it)
          val xv = fresh("__x")
          pushScope([x])
          loops = loops.push(l)
          val body = block(b)
          loops = loops.take(loops.count() - 1)
          popScope()
          "$l: for $xv in rt::iter($src) { let mut ${rid(x)}: Value = $xv; $body; }"
        }
      }
    }
  }

  // ------------------------------------------------------------ expressions
  fun argsVec(args: Vec<Arg>): String {
    var v: Vec<String> = []
    for a in args { v = v.push(expr(a.value)) }
    "vec![${v.join(", ")}]"
  }
  fun ordered(params: Vec<Param>, args: Vec<Arg>): Vec<String> {
    val ord = orderArgs(params, args)
    var out: Vec<String> = []
    for k in 0..params.count() {
      val given = ord[k]
      val p = params[k]!!
      out = out.push(if given != nil { expr(given) } else if p.dflt != nil { expr(p.dflt!!) } else { "Value::Nil" })
    }
    out
  }

  fun capture(body: Expr, params: Vec<String>): String {
    val acc = NameAcc()
    freeNames(body, acc)
    val caps = acc.names.keys().filter(|x| isLocal(x) && !params.contains(x)).sort()
    var s = caps.map(|x| "let ${rid(x)} = ${rid(x)}.clone(); ").join("")
    if acc.usesThis && curClass != nil { s = s & "let this = this.clone(); " }
    s
  }

  fun lambda(params: Vec<Param>, body: Expr): String {
    val pnames = params.map(|p| p.name)
    val caps = capture(body, pnames)
    val saved = loops
    loops = []
    pushScope(pnames)
    var binds: Vec<String> = []
    for k in 0..params.count() { binds = binds.push("let mut ${rid(params[k]!!.name)}: Value = __a.get($k).cloned().unwrap_or(Value::Nil); ") }
    val b = expr(body)
    popScope()
    loops = saved
    "{ ${caps}rt::func(move |__a: Vec<Value>| -> Value { ${binds.join("")}$b }) }"
  }

  fun getArgs(k: Int): String {
    var a: Vec<String> = []
    for i in 0..k { a = a.push("a.get($i).cloned().unwrap_or(Value::Nil)") }
    a.join(", ")
  }

  fun fnValue(x: String): String? {
    val f = d.funs[x]
    if f != nil { return "rt::func(|a: Vec<Value>| ${fname(x)}(${getArgs(f.params.count())}))" }
    val c = d.classes[x]
    if c != nil { return "rt::func(|a: Vec<Value>| new_$x(${getArgs(c.params.count())}))" }
    if info.generics.containsKey(x) { return "rt::func(|a: Vec<Value>| rt::call_generic(${lit(x)}, a))" }
    nil
  }

  fun variantCall(vname: String, args: Vec<Arg>): String {
    if vname == "Ok" || vname == "Err" {
      val a = if args.isEmpty() { "Value::Nil" } else { expr(args[0]!!.value) }
      return "rt::${vname.lower()}($a)"
    }
    val en = info.variantOf[vname]!!
    val ed = d.enums.find(|e| e.name == en)!!
    val vd = ed.variants.find(|v| v.name == vname)!!
    "${en}__$vname(${ordered(vd.fields, args).join(", ")})"
  }

  fun isEnumVariantRef(obj: Expr, member: String): Bool = match obj.kind {
    EIdent(en) => !isLocal(en) && info.enums.containsKey(en) && info.variantOf[member] == en
    _ => false
  }

  fun call(callee: Expr, args: Vec<Arg>): String {
    match callee.kind {
      EIdent(x) if !isLocal(x) && !isField(x) => {
        if x == "embedFile" && args.count() == 1 {
          match (args[0]!!).value.kind {
            EStr(segs) => {
              if segs.count() == 1 {
                match segs[0]!! {
                  SegLit(path) => {
                    val text = match readFile(baseDir & "/" & path) {
                      Ok(t) => t
                      Err(e) => { eprintln("error: embedFile: cannot read $path: $e"); exit(1); "" }
                    }
                    return "rt::s(${lit(text)})"
                  }
                  _ => {}
                }
              }
            }
            _ => {}
          }
        }
        if x == "callNext" { return if args.isEmpty() { "__next(__args.clone())" } else { "__next(${argsVec(args)})" } }
        if isMethod(x) { return "rt::call_self(&this, ${lit(x)}, ${argsVec(args)})" }
        val f = d.funs[x]
        if f != nil { return "${fname(x)}(${ordered(f.params, args).join(", ")})" }
        val c = d.classes[x]
        if c != nil { return "new_$x(${ordered(c.params, args).join(", ")})" }
        if info.variantOf.containsKey(x) { return variantCall(x, args) }
        if info.generics.containsKey(x) { return "rt::call_generic(${lit(x)}, ${argsVec(args)})" }
        if isBuiltin(x) {
          var a: Vec<String> = []
          for ar in args { a = a.push(expr(ar.value)) }
          val at0 = a[0] ?: "Value::Nil"
          val at1 = a[1] ?: "Value::Nil"
          return match x {
            "println" => "rt::println(&${if a.isEmpty() { "rt::s(\"\")" } else { at0 }})"
            "print" => "rt::print(&$at0)"
            "str" => "rt::s(&rt::to_str(&$at0))"
            "atom" => "rt::atom($at0)"
            "range" => "rt::range(&$at0, &$at1)"
            "panic" => "rt::fail(rt::to_str(&$at0))"
            "assert" => "rt::assert(&$at0, &${if a.count() > 1 { at1 } else { "rt::s(\"\")" }})"
            _ => "rt::sheets(${lit(x)}, vec![${a.join(", ")}])"
          }
        }
        val fr = rf(callee)
        "rt::apply($fr, ${argsVec(args)})"
      }
      EMember(obj, mname, safe) => {
        if isEnumVariantRef(obj, mname) { return variantCall(mname, args) }
        if mname == "copy" && args.all(|a| a.name != nil) && !args.isEmpty() {
          val o = rf(obj)
          var ch: Vec<String> = []
          for a in args { ch = ch.push("(${lit(a.name!!)}, ${expr(a.value)})") }
          return "rt::copy($o, vec![${ch.join(", ")}])"
        }
        val o = rf(obj)
        val av = argsVec(args)
        val isThis = match obj.kind { EThis => true, _ => false }
        if isThis { return "rt::call_self($o, ${lit(mname)}, $av)" }
        "rt::${if safe { "call_safe" } else { "call" }}($o, ${lit(mname)}, $av)"
      }
      _ => { val f = rf(callee); "rt::apply($f, ${argsVec(args)})" }
    }
  }

  fun pattern(p: Pattern, acc: String, out: PatAcc) {
    match p {
      PBind(x) => { out.binds = out.binds.push([x, acc]) }
      PLit(e) => { out.conds = out.conds.push("rt::eq(&$acc, &${expr(e)})") }
      PVariant(vn, pargs, _) => {
        out.conds = out.conds.push("rt::is_variant(&$acc, ${lit(vn)})")
        for k in 0..pargs.count() { pattern(pargs[k]!!, "rt::vfield(&$acc, $k)", out) }
      }
      _ => {}
    }
  }

  fun binFn(op: String): String = match op {
    "+" => "add"
    "-" => "sub"
    "*" => "mul"
    "/" => "div"
    "%" => "rem"
    "^" => "pow"
    "&" => "amp"
    "==" => "op_eq"
    "!=" => "op_ne"
    "<" => "lt"
    "<=" => "le"
    ">" => "gt"
    ">=" => "ge"
    _ => "?"
  }

  fun expr(e: Expr): String = match e.kind {
    EInt(i) => "Value::Int($i)"
    EFloat(f) => "Value::Float(${floatLit(f)})"
    EDecimal(t) => "rt::dec(${lit(t)})"
    EQuantity(x, u) => "rt::qty(${expr(x)}, ${lit(u)})"
    EStr(segs) => {
      if segs.count() == 1 {
        match segs[0]!! {
          SegLit(l) => { return "rt::s(${lit(l)})" }
          _ => {}
        }
      }
      var parts: Vec<String> = []
      for sg in segs { parts = parts.push(match sg { SegLit(l) => "rt::s(${lit(l)})", SegExpr(x) => expr(x) }) }
      "rt::concat(vec![${parts.join(", ")}])"
    }
    EBool(b) => "Value::Bool($b)"
    ENil => "Value::Nil"
    EThis => "this.clone()"
    EResult => "result.clone()"
    EOld(_, slot) => "__old$slot.clone()"
    EIdent(x) => identExpr(x)
    ECellRef(c) => "rt::cell(__sheet, ${lit(c)})"
    ECellRange(a, b) => "rt::cell_range(__sheet, ${lit(a)}, ${lit(b)})"
    EBinary(op, l, r) => {
      if op == "&&" { val a = rf(l); "Value::Bool(rt::truthy($a) && rt::truthy(${rf(r)}))" }
      else if op == "||" { val a = rf(l); "Value::Bool(rt::truthy($a) || rt::truthy(${rf(r)}))" }
      else if op == "?:" { val a = expr(l); "{ let __t = $a; if __t.is_nil() { ${expr(r)} } else { __t } }" }
      else { val a = rf(l); val b = rf(r); "rt::${binFn(op)}($a, $b)" }
    }
    EUnary(op, x) => "rt::${if op == "-" { "neg" } else { "not" }}(${rf(x)})"
    ECall(c, args) => call(c, args)
    EMember(obj, mname, safe) => {
      if isEnumVariantRef(obj, mname) { variantCall(mname, []) }
      else { val o = rf(obj); "rt::${if safe { "get_safe" } else { "get" }}($o, ${lit(mname)})" }
    }
    ESuper(q, mname, args) => {
      val av = argsVec(args)
      if q != nil { "rt::call_from(&this, ${lit(q!!)}, ${lit(mname)}, $av)" }
      else { "rt::call_super(&this, ${lit(curClass ?: "")}, ${lit(mname)}, $av)" }
    }
    EIndex(o, i) => { val a = rf(o); "rt::index($a, ${rf(i)})" }
    ELambda(ps, b) => lambda(ps, b)
    EIf(c, t, el) => {
      val cond = rf(c)
      val tb = block(t)
      val eb = if el != nil { block(el!!) } else { "{ Value::Nil }" }
      "if rt::truthy($cond) $tb else $eb"
    }
    EMatch(subject, arms) => matchExpr(subject, arms)
    EVec(items) => { var v: Vec<String> = []; for i in items { v = v.push(expr(i)) }; "rt::vec(vec![${v.join(", ")}])" }
    EMap(entries) => mapExpr(entries)
    ETry(x) => "match rt::try_branch(${expr(x)}) { Ok(__v) => __v, Err(__e) => return __e }"
    ENotNull(x) => "rt::not_null(${expr(x)}, \"value\")"
    ERange(a, b) => { val x = rf(a); "rt::range($x, ${rf(b)})" }
    EBlock(b) => block(b)
    EIs(x, ty) => {
      val tn = match ty { TName(nm, _, _) => nm, _ => "Any" }
      "Value::Bool(rt::is_instance(${rf(x)}, ${lit(tn)}))"
    }
    ESheet(cells) => sheetExpr(cells)
    _ => "/* desugared */"
  }

  fun identExpr(x: String): String {
    if isLocal(x) { return "${rid(x)}.clone()" }
    if isField(x) || isMethod(x) { return "rt::get(&this, ${lit(x)})" }
    val fv = fnValue(x)
    if fv != nil { return fv }
    if info.variantOf.containsKey(x) {
      val fields = info.variantFields(x) ?: []
      val en = info.variantOf[x]!!
      if fields.isEmpty() { return "${en}__$x()" }
      if x == "Ok" || x == "Err" { return "rt::func(|a: Vec<Value>| rt::${x.lower()}(${getArgs(fields.count())}))" }
      return "rt::func(|a: Vec<Value>| ${en}__$x(${getArgs(fields.count())}))"
    }
    if isBuiltin(x) { return "rt::func(|a: Vec<Value>| rt::sheets(${lit(x)}, a))" }
    "${rid(x)}.clone()"
  }

  fun matchExpr(subject: Expr, arms: Vec<MatchArm>): String {
    val lbl = fresh("'m")
    val mv = fresh("__m")
    var out: Vec<String> = ["$lbl: { let $mv = ${expr(subject)}; "]
    for a in arms {
      val pa = PatAcc()
      pattern(a.pat, mv, pa)
      pushScope(pa.binds.map(|b| b[0]))
      val bs = pa.binds.map(|b| "let mut ${rid(b[0])}: Value = ${b[1]}; ").join("")
      // a labeled block as a break value is parenthesised: `break 'a ('b: { .. })`
      val bv = expr(a.body)
      val body = if bv.startsWith("'") { "($bv)" } else { bv }
      val inner = if a.guard != nil { "${bs}if rt::truthy(${rf(a.guard!!)}) { break $lbl $body; }" } else { "${bs}break $lbl $body;" }
      popScope()
      if pa.conds.isEmpty() { out = out.push("{ $inner } ") } else { out = out.push("if ${pa.conds.join(" && ")} { $inner } ") }
    }
    out = out.push("rt::fail(format!(\"no match arm for {}\", rt::repr(&$mv))) }")
    out.join("")
  }

  fun mapExpr(entries: Vec<MapEntry>): String {
    val allKv = entries.all(|en| match en { MKv(_, _) => true, _ => false })
    if allKv {
      var v: Vec<String> = []
      for en in entries { match en { MKv(k, x) => { val ks = expr(k); v = v.push("($ks, ${expr(x)})") }, _ => {} } }
      return "rt::map(vec![${v.join(", ")}])"
    }
    var s: Vec<String> = ["{ let mut __mp = rt::map(vec![]); "]
    for en in entries {
      match en {
        MSpread(x) => { val v = rf(x); s = s.push("__mp = rt::merge(&__mp, $v); ") }
        MKv(k, x) => { val ks = expr(k); s = s.push("__mp = rt::assoc(&__mp, $ks, ${expr(x)}); ") }
      }
    }
    s = s.push("__mp }")
    s.join("")
  }

  fun sheetExpr(cells: Vec<SheetCell>): String {
    var parts: Vec<String> = []
    for c in cells {
      if isFormula(c.value) {
        val caps = capture(c.value, [])
        val saved = loops
        loops = []
        pushScope([])
        val body = expr(c.value)
        popScope()
        loops = saved
        parts = parts.push("(${lit(c.cell)}, { ${caps}rt::formula(move |__sheet: &Value| -> Value { $body }) })")
      } else {
        parts = parts.push("(${lit(c.cell)}, rt::Cell::Val(${expr(c.value)}))")
      }
    }
    "rt::sheet(vec![${parts.join(", ")}])"
  }
}

class PatAcc {
  var conds: Vec<String> = []
  var binds: Vec<Vec<String>> = []
}
