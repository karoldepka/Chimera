fun fib(n: Int): Int
  require n >= 0
= if n < 2 { n } else { fib(n - 1) + fib(n - 2) }

fun dynFib(n) = if n < 2 { n } else { dynFib(n - 1) + dynFib(n - 2) }

fun collatz(start: Int): Int {
  var n = start
  var steps = 0
  while n != 1 {
    if n % 2 == 0 { n = n / 2 } else { n = 3 * n + 1 }
    steps += 1
  }
  steps
}

fun main() {
  println("fib(32) = ${fib(32)}")
  println("dynFib(25) = ${dynFib(25)}")
  println("collatz(27) = ${collatz(27)}")
}
